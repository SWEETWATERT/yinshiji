page {
  min-height: 100vh;
  color: #2f2936;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #f7f8fa;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.page,
.page-container {
  width: 100%;
  max-width: 686rpx;
  min-height: 100vh;
  margin: 0 auto;
  padding: 24rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
}

.page-title {
  color: #2f2936;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 6rpx;
  color: #8c8498;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}

.section-card,
.glass-card {
  width: 100%;
  border: 1rpx solid rgba(42, 34, 48, 0.05);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 25, 36, 0.05);
  text-align: left;
}

.section-title {
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.muted,
.soft-label {
  color: #8c8498;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}

.primary-button,
.gradient-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #f58bb8 0%, #8d7cf0 100%);
  box-shadow: 0 12rpx 24rpx rgba(141, 124, 240, 0.18);
}

.chip,
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #5f576a;
  font-size: 24rpx;
  font-weight: 400;
  background: #f1eff4;
  white-space: nowrap;
}

.chip-active,
.chip.active,
.tag.active {
  color: #fff;
  background: linear-gradient(135deg, #f58bb8 0%, #8d7cf0 100%);
}

.progress-bar,
.progress {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ece8ef;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f58bb8 0%, #8d7cf0 100%);
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.fixed-bottom-button {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  padding: 24rpx 32rpx 0;
  background: linear-gradient(180deg, rgba(247,248,250,0), #f7f8fa 42%);
  z-index: 20;
}

.fixed-bottom-button .primary-button {
  width: 520rpx;
  height: 88rpx;
  min-height: 88rpx;
}

.icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  background: #f1eff4;
}
