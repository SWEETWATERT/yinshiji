/* ═══════════ 健康饮食记 · 视觉系统 v3 · 简约成熟 ═══════════ */

page {
  min-height: 100vh;
  color: #25232A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #F7F2EA;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1.2;
}

button::after {
  border: 0;
}

/* ── Page Container ── */
.page,
.page-container {
  width: 100%;
  max-width: 750rpx;
  min-height: 100vh;
  margin: 0 auto;
  padding: 32rpx 32rpx calc(152rpx + env(safe-area-inset-bottom));
  background: transparent;
  position: relative;
  z-index: 2;
}

/* ── Abstract Background Layer ── */
.page-bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.page-bg-img {
  width: 100%;
  height: 100%;
}

/* ── Typography ── */
.page-title {
  color: #25232A;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.5rpx;
}

.page-subtitle {
  margin-top: 6rpx;
  color: #807987;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.4;
}

.section-title {
  color: #25232A;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.muted,
.soft-label {
  color: #807987;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
}

/* ── Card ── */
.glass-card,
.section-card {
  width: 100%;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E9E1D8;
  box-shadow: 0 2rpx 12rpx rgba(37, 35, 42, 0.05);
  text-align: left;
}

/* ── Primary Button ── */
.primary-button,
.gradient-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF83B7 0%, #8B6CFF 100%);
  box-shadow: 0 8rpx 24rpx rgba(139, 108, 255, 0.28);
  letter-spacing: 0.5rpx;
}

/* ── Pill Tags ── */
.chip,
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #807987;
  font-size: 26rpx;
  font-weight: 500;
  background: #FFFFFF;
  border: 1.5rpx solid #E9E1D8;
  white-space: nowrap;
}

.chip-active,
.chip.active,
.tag.active {
  color: #fff;
  background: #8B6CFF;
  border-color: #8B6CFF;
  box-shadow: 0 4rpx 12rpx rgba(139, 108, 255, 0.25);
}

/* ── Progress ── */
.progress-bar,
.progress {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E9E1D8;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FF83B7 0%, #8B6CFF 100%);
}

/* ── Fixed Bottom Button ── */
.fixed-bottom-button {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  padding: 20rpx 32rpx 16rpx;
  background: linear-gradient(180deg, transparent, rgba(247, 242, 234, 0.97) 52%);
  z-index: 20;
}

.fixed-bottom-button .primary-button {
  width: 100%;
  max-width: 560rpx;
  height: 88rpx;
  min-height: 88rpx;
}

/* ── Icon Box ── */
.icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  background: #F7F2EA;
  border-radius: 12rpx;
}

/* ── Safe bottom ── */
.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
