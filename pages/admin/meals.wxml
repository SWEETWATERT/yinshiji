<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.08;"></image>
</view>

<view class="page page-container admin-meals-page">
  <brand-header></brand-header>

  <view class="meals-header">
    <view>
      <view class="page-title">{{title}}</view>
      <view class="page-subtitle">{{desc}}</view>
    </view>
    <button class="refresh-button" bindtap="refreshMeals" disabled="{{loading}}">
      {{loading ? '加载中' : '刷新'}}
    </button>
  </view>

  <view class="section-card meals-summary">
    <view class="summary-label">总记录数</view>
    <view class="summary-value-row">
      <text class="summary-value">{{total}}</text>
      <text class="summary-unit">条</text>
    </view>
    <view class="summary-desc">当前显示第 {{page}} 页，每页 {{pageSize}} 条</view>
  </view>

  <view wx:if="{{loading}}" class="section-card state-card">
    <view class="state-title">加载中</view>
    <view class="state-desc">正在读取 meal_records 餐食记录。</view>
  </view>

  <view wx:elif="{{error}}" class="section-card state-card error-card">
    <view class="state-title">{{error}}</view>
    <view class="state-desc">请确认当前账号有后台权限，且 adminApi 云函数已部署。</view>
    <button class="retry-button" bindtap="refreshMeals">重试</button>
  </view>

  <view wx:elif="{{meals.length === 0}}" class="section-card state-card">
    <view class="state-title">暂无餐食记录</view>
    <view class="state-desc">meal_records 集合暂时没有可展示的餐食数据。</view>
  </view>

  <view wx:else class="meals-list">
    <block wx:for="{{meals}}" wx:key="id">
      <view class="section-card meal-card">
        <view class="meal-card-head">
          <view>
            <view class="meal-type">{{item.mealTypeText}}</view>
            <view class="meal-summary">{{item.foodSummary}}</view>
          </view>
          <view class="image-pill">{{item.imageText}}</view>
        </view>

        <view class="meal-main-row">
          <view>
            <view class="kcal-label">热量</view>
            <view class="kcal-value">{{item.kcal}}</view>
          </view>
          <view class="ai-pill">{{item.aiStatus}}</view>
        </view>

        <view class="nutrition-grid">
          <view class="nutrition-item">
            <text class="nutrition-label">蛋白质</text>
            <text class="nutrition-value">{{item.protein}}</text>
          </view>
          <view class="nutrition-item">
            <text class="nutrition-label">碳水</text>
            <text class="nutrition-value">{{item.carbs}}</text>
          </view>
          <view class="nutrition-item">
            <text class="nutrition-label">脂肪</text>
            <text class="nutrition-value">{{item.fat}}</text>
          </view>
        </view>

        <view class="meal-meta-list">
          <view class="meta-row">
            <text class="meta-label">用户</text>
            <text class="meta-value">{{item.maskedOpenid}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">创建时间</text>
            <text class="meta-value">{{item.createdAt}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
