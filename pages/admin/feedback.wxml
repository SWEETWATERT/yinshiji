<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.08;"></image>
</view>

<view class="page page-container admin-feedback-page">
  <brand-header></brand-header>

  <view class="feedback-header">
    <view>
      <view class="page-title">{{title}}</view>
      <view class="page-subtitle">{{desc}}</view>
    </view>
    <button class="refresh-button" bindtap="refreshFeedback" disabled="{{loading}}">
      {{loading ? '加载中' : '刷新'}}
    </button>
  </view>

  <view class="section-card feedback-summary">
    <view class="summary-label">总反馈数</view>
    <view class="summary-value-row">
      <text class="summary-value">{{total}}</text>
      <text class="summary-unit">条</text>
    </view>
    <view class="summary-desc">当前筛选：{{currentStatusText}} · 第 {{page}} / {{totalPages}} 页，每页 {{pageSize}} 条</view>
  </view>

  <scroll-view class="status-scroll" scroll-x>
    <view class="status-list">
      <block wx:for="{{filters}}" wx:key="value">
        <button
          class="status-chip {{currentStatus === item.value ? 'status-chip-active' : ''}}"
          data-status="{{item.value}}"
          bindtap="changeStatus"
        >
          {{item.label}}
        </button>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="section-card state-card">
    <view class="state-title">加载中</view>
    <view class="state-desc">正在读取 user_feedback 用户反馈。</view>
  </view>

  <view wx:elif="{{error}}" class="section-card state-card error-card">
    <view class="state-title">{{error}}</view>
    <view class="state-desc">请确认当前账号有后台权限，且 adminApi 云函数已部署。</view>
    <button class="retry-button" bindtap="refreshFeedback">重试</button>
  </view>

  <view wx:elif="{{feedback.length === 0}}" class="section-card state-card">
    <view class="state-title">暂无用户反馈</view>
    <view class="state-desc">user_feedback 集合暂时没有可展示的反馈。</view>
  </view>

  <view wx:else class="feedback-list">
    <block wx:for="{{feedback}}" wx:key="id">
      <view class="section-card feedback-card">
        <view class="feedback-card-head">
          <view>
            <view class="feedback-type">{{item.typeText}}</view>
            <view class="feedback-content">{{item.content}}</view>
          </view>
          <view class="status-pill">{{item.statusText}}</view>
        </view>

        <view class="feedback-grid">
          <view class="feedback-field">
            <text class="field-label">联系方式</text>
            <text class="field-value">{{item.contact}}</text>
          </view>
          <view class="feedback-field">
            <text class="field-label">用户</text>
            <text class="field-value">{{item.maskedOpenid}}</text>
          </view>
        </view>

        <view wx:if="{{item.mealContext.hasMealLink}}" class="meal-context-card">
          <view class="meal-context-title">关联餐食</view>
          <view class="meal-context-grid">
            <view class="meal-context-item">
              <text class="field-label">餐食记录</text>
              <text class="field-value">{{item.mealContext.mealRecordIdText}}</text>
            </view>
            <view class="meal-context-item">
              <text class="field-label">分析记录</text>
              <text class="field-value">{{item.mealContext.analysisIdText}}</text>
            </view>
            <view class="meal-context-item">
              <text class="field-label">图片</text>
              <text class="field-value">{{item.mealContext.imageText}}</text>
            </view>
          </view>
          <view class="meal-food-summary">{{item.mealContext.foodSummary}}</view>
          <view wx:if="{{item.mealContext.contextItems.length}}" class="meal-context-list">
            <block wx:for="{{item.mealContext.contextItems}}" wx:key="label">
              <view class="context-row">
                <text class="context-label">{{item.label}}</text>
                <text class="context-value">{{item.value}}</text>
              </view>
            </block>
          </view>
        </view>

        <view class="feedback-meta-list">
          <view class="meta-row">
            <text class="meta-label">创建时间</text>
            <text class="meta-value">{{item.createdAt}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">更新时间</text>
            <text class="meta-value">{{item.updatedAt}}</text>
          </view>
        </view>

        <view wx:if="{{item.canMarkProcessing || item.canResolve || item.canClose}}" class="feedback-actions">
          <button
            wx:if="{{item.canMarkProcessing}}"
            class="action-button secondary-button"
            data-id="{{item.id}}"
            bindtap="markProcessing"
            disabled="{{updatingFeedbackId === item.id}}"
          >
            {{updatingFeedbackId === item.id ? '处理中' : '标记处理中'}}
          </button>
          <button
            wx:if="{{item.canResolve}}"
            class="action-button primary-button"
            data-id="{{item.id}}"
            bindtap="resolveFeedback"
            disabled="{{updatingFeedbackId === item.id}}"
          >
            {{updatingFeedbackId === item.id ? '处理中' : '已处理'}}
          </button>
          <button
            wx:if="{{item.canClose}}"
            class="action-button danger-button"
            data-id="{{item.id}}"
            bindtap="closeFeedback"
            disabled="{{updatingFeedbackId === item.id}}"
          >
            {{updatingFeedbackId === item.id ? '处理中' : '关闭'}}
          </button>
        </view>
      </view>
    </block>

    <view class="pager-card">
      <button class="pager-button" bindtap="prevPage" disabled="{{loading || page <= 1}}">上一页</button>
      <view class="pager-text">第 {{page}} / {{totalPages}} 页</view>
      <button class="pager-button" bindtap="nextPage" disabled="{{loading || page >= totalPages}}">下一页</button>
    </view>
  </view>
</view>
