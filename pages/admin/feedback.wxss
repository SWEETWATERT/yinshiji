.admin-feedback-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.feedback-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.refresh-button,
.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 116rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #8B6CFF;
  background: #EEE8FF;
  font-size: 24rpx;
  font-weight: 700;
}

.refresh-button[disabled] {
  opacity: 0.6;
}

.feedback-summary {
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.summary-label {
  color: #807987;
  font-size: 24rpx;
}

.summary-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 12rpx;
}

.summary-value {
  color: #25232A;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-unit {
  color: #807987;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-desc {
  margin-top: 14rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.status-list {
  display: inline-flex;
  gap: 14rpx;
  min-width: 100%;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #807987;
  background: #FFFFFF;
  border: 1rpx solid #E9E1D8;
  font-size: 24rpx;
  font-weight: 700;
}

.status-chip-active {
  color: #FFFFFF;
  background: #8B6CFF;
  border-color: #8B6CFF;
}

.state-card {
  padding: 34rpx 28rpx;
  margin-top: 20rpx;
}

.error-card {
  border-color: #F0D6DC;
  background: #FFF8FA;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
}

.error-card .state-title {
  color: #D94B73;
}

.state-desc {
  margin-top: 12rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.55;
}

.retry-button {
  width: 160rpx;
  margin-top: 22rpx;
}

.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.feedback-card {
  padding: 26rpx;
}

.feedback-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.feedback-type {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.feedback-content {
  margin-top: 10rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8B6CFF;
  background: #EEE8FF;
  font-size: 22rpx;
  font-weight: 700;
}

.feedback-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.feedback-field {
  min-height: 96rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
}

.field-label {
  display: block;
  color: #807987;
  font-size: 22rpx;
  line-height: 1.25;
}

.field-value {
  display: block;
  margin-top: 10rpx;
  color: #25232A;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-all;
}

.meal-context-card {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
}

.meal-context-title {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 700;
}

.meal-context-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.meal-context-item {
  min-width: 0;
}

.meal-food-summary {
  margin-top: 16rpx;
  color: #25232A;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.meal-context-list {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #EFE7DE;
}

.context-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 40rpx;
}

.context-row + .context-row {
  margin-top: 8rpx;
}

.context-label {
  flex-shrink: 0;
  color: #807987;
  font-size: 22rpx;
}

.context-value {
  color: #25232A;
  font-size: 22rpx;
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}

.feedback-meta-list {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0ECE7;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 44rpx;
}

.meta-row + .meta-row {
  margin-top: 8rpx;
}

.meta-label {
  flex-shrink: 0;
  color: #807987;
  font-size: 23rpx;
}

.meta-value {
  color: #25232A;
  font-size: 23rpx;
  font-weight: 600;
  text-align: right;
}

.feedback-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0ECE7;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.primary-button {
  color: #FFFFFF;
  background: #8B6CFF;
}

.secondary-button {
  color: #8B6CFF;
  background: #EEE8FF;
}

.danger-button {
  color: #D94B73;
  background: #FFF0F4;
  border: 1rpx solid #F0D6DC;
}

.action-button[disabled] {
  opacity: 0.6;
}

.pager-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 4rpx;
  padding: 18rpx 0 8rpx;
}

.pager-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  color: #8B6CFF;
  background: #EEE8FF;
  font-size: 24rpx;
  font-weight: 700;
}

.pager-button[disabled] {
  color: #B8B1C2;
  background: #F1EFF4;
}

.pager-text {
  color: #807987;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}
