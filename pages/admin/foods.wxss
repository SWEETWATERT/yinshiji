.admin-foods-page {
  opacity: 0.96;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.foods-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.header-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.add-button,
.refresh-button,
.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 116rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #6B6570;
  background: #F5F1ED;
  font-size: 24rpx;
  font-weight: 700;
}

.add-button {
  color: #25232A;
  background: #EFE7DE;
}

.refresh-button[disabled] {
  opacity: 0.6;
}

.foods-summary {
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
  background: #FFFEFC;
}

.search-card {
  padding: 22rpx;
  margin-bottom: 20rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #25232A;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
  font-size: 25rpx;
  box-sizing: border-box;
}

.search-button,
.clear-button,
.pager-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  color: #6B6570;
  background: #F5F1ED;
  font-size: 25rpx;
  font-weight: 700;
}

.search-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: #807987;
  font-size: 24rpx;
}

.clear-button {
  height: 56rpx;
  padding: 0 18rpx;
  color: #807987;
  background: #FAF8F5;
  font-size: 23rpx;
}

.food-form-card {
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.form-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.form-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.form-desc {
  margin-top: 8rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.form-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 104rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #807987;
  background: #FAF8F5;
  font-size: 24rpx;
  font-weight: 700;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.form-field {
  min-width: 0;
}

.form-field-full {
  grid-column: span 2;
}

.form-label {
  display: block;
  color: #807987;
  font-size: 23rpx;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.form-input {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #25232A;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
  font-size: 25rpx;
  box-sizing: border-box;
}

.enabled-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #F0ECE7;
}

.enabled-title {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 700;
}

.enabled-desc {
  margin-top: 6rpx;
  color: #807987;
  font-size: 23rpx;
  line-height: 1.4;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 78rpx;
  margin-top: 8rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
  background: #8B6CFF;
  font-size: 27rpx;
  font-weight: 700;
}

.summary-label {
  color: #807987;
  font-size: 24rpx;
}

.summary-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 12rpx;
}

.summary-value {
  color: #25232A;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-unit {
  color: #807987;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-desc {
  margin-top: 14rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-card {
  padding: 34rpx 28rpx;
  margin-top: 20rpx;
}

.error-card {
  border-color: #F0D6DC;
  background: #FFF8FA;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
}

.error-card .state-title {
  color: #D94B73;
}

.state-desc {
  margin-top: 12rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.55;
}

.retry-button {
  width: 160rpx;
  margin-top: 22rpx;
}

.foods-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.inline-error-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx;
  color: #B84A62;
  background: #FFF8FA;
  border-color: #F0D6DC;
  font-size: 24rpx;
  line-height: 1.45;
}

.inline-retry-button {
  width: 128rpx;
  height: 56rpx;
  margin-top: 0;
}

.food-card {
  padding: 22rpx;
  box-shadow: none;
}

.food-card-enabled {
  border-color: #E3EEDB;
}

.food-card-disabled {
  border-color: #EFE0E0;
  background: #FFFCFC;
}

.food-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.food-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #FAF8F5;
  font-size: 34rpx;
}

.food-title-wrap {
  flex: 1;
  min-width: 0;
}

.food-name {
  color: #25232A;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.3;
}

.food-secondary-name {
  margin-top: 6rpx;
  color: #6B6570;
  font-size: 23rpx;
  line-height: 1.35;
}

.food-category {
  margin-top: 8rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.35;
}

.status-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-enabled {
  color: #2F7D4B;
  background: #E9F6EE;
}

.status-disabled {
  color: #B84A62;
  background: #FFF0F4;
}

.kcal-row {
  margin-top: 24rpx;
}

.kcal-label {
  color: #807987;
  font-size: 22rpx;
  line-height: 1.2;
}

.kcal-value {
  margin-top: 8rpx;
  color: #25232A;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.nutrition-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.nutrition-item {
  min-height: 78rpx;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
}

.nutrition-label {
  display: block;
  color: #807987;
  font-size: 22rpx;
  line-height: 1.25;
}

.nutrition-value {
  display: block;
  margin-top: 10rpx;
  color: #25232A;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.food-meta-list {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0ECE7;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 44rpx;
}

.meta-label {
  flex-shrink: 0;
  color: #807987;
  font-size: 23rpx;
}

.meta-value {
  color: #25232A;
  font-size: 23rpx;
  font-weight: 600;
  text-align: right;
}

.food-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0ECE7;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 72rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-button {
  color: #FFFFFF;
  background: #8B6CFF;
}

.secondary-button {
  color: #8B6CFF;
  background: #EEE8FF;
}

.danger-button {
  color: #D94B73;
  background: #FFF0F4;
  border: 1rpx solid #F0D6DC;
}

.action-button[disabled],
.submit-button[disabled],
.add-button[disabled],
.search-button[disabled],
.clear-button[disabled],
.pager-button[disabled] {
  opacity: 0.6;
}

.pager-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx;
  margin-top: 18rpx;
}

.pager-text {
  flex: 1;
  color: #807987;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.pager-subtext {
  margin-top: 6rpx;
  color: #9A929F;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.3;
}

.load-more-row {
  padding: 24rpx 0 4rpx;
  color: #9A929F;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: center;
}
