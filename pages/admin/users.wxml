<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.08;"></image>
</view>

<view class="page page-container admin-users-page">
  <brand-header></brand-header>

  <view class="users-header">
    <view>
      <view class="page-title">{{title}}</view>
      <view class="page-subtitle">{{desc}}</view>
    </view>
    <button class="refresh-button" bindtap="refreshUsers" disabled="{{loading}}">
      {{loading ? '加载中' : '刷新'}}
    </button>
  </view>

  <view class="section-card users-summary">
    <view class="summary-label">总用户数</view>
    <view class="summary-value-row">
      <text class="summary-value">{{total}}</text>
      <text class="summary-unit">人</text>
    </view>
    <view class="summary-desc">当前显示第 {{page}} 页，每页 {{pageSize}} 条</view>
  </view>

  <view wx:if="{{loading}}" class="section-card state-card">
    <view class="state-title">加载中</view>
    <view class="state-desc">正在读取 users 集合数据。</view>
  </view>

  <view wx:elif="{{error}}" class="section-card state-card error-card">
    <view class="state-title">{{error}}</view>
    <view class="state-desc">请确认当前账号有后台权限，且 adminApi 云函数已部署。</view>
    <button class="retry-button" bindtap="refreshUsers">重试</button>
  </view>

  <view wx:elif="{{users.length === 0}}" class="section-card state-card">
    <view class="state-title">暂无用户</view>
    <view class="state-desc">users 集合暂时没有可展示的用户资料。</view>
  </view>

  <view wx:else class="users-list">
    <block wx:for="{{users}}" wx:key="id">
      <view class="section-card user-card">
        <view class="user-card-head">
          <view>
            <view class="user-name">{{item.nickName}}</view>
            <view class="user-openid">openid：{{item.maskedOpenid}}</view>
          </view>
          <view class="gender-pill">{{item.gender}}</view>
        </view>

        <view class="user-grid">
          <view class="user-field">
            <text class="field-label">身高</text>
            <text class="field-value">{{item.heightCm}}</text>
          </view>
          <view class="user-field">
            <text class="field-label">体重</text>
            <text class="field-value">{{item.weightKg}}</text>
          </view>
          <view class="user-field">
            <text class="field-label">BMI</text>
            <text class="field-value">{{item.bmi}}</text>
          </view>
          <view class="user-field">
            <text class="field-label">档案</text>
            <text class="field-value">{{item.profileCompletedText}}</text>
          </view>
          <view class="user-field">
            <text class="field-label">热量目标</text>
            <text class="field-value">{{item.calorieTarget}}</text>
          </view>
        </view>

        <view class="user-time-list">
          <view class="time-row">
            <text class="time-label">创建时间</text>
            <text class="time-value">{{item.createdAt}}</text>
          </view>
          <view class="time-row">
            <text class="time-label">最近登录</text>
            <text class="time-value">{{item.lastLoginAt}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
