.admin-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.admin-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.admin-badge {
  max-width: 220rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #8B6CFF;
  background: #EEE8FF;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.admin-summary {
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.summary-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
}

.summary-desc {
  margin-top: 10rpx;
  color: #807987;
  font-size: 25rpx;
  line-height: 1.55;
}

.admin-menu {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.admin-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 26rpx;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: #25232A;
  font-size: 29rpx;
  font-weight: 700;
}

.menu-desc {
  margin-top: 8rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.menu-arrow {
  color: #8B6CFF;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}
