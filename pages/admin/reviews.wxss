.admin-reviews-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.reviews-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.refresh-button,
.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 116rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #8B6CFF;
  background: #EEE8FF;
  font-size: 24rpx;
  font-weight: 700;
}

.refresh-button[disabled] {
  opacity: 0.6;
}

.reviews-summary {
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.summary-label {
  color: #807987;
  font-size: 24rpx;
}

.summary-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 12rpx;
}

.summary-value {
  color: #25232A;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-unit {
  color: #807987;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-desc {
  margin-top: 14rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.status-list {
  display: inline-flex;
  gap: 14rpx;
  min-width: 100%;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #807987;
  background: #FFFFFF;
  border: 1rpx solid #E9E1D8;
  font-size: 24rpx;
  font-weight: 700;
}

.status-chip-active {
  color: #FFFFFF;
  background: #8B6CFF;
  border-color: #8B6CFF;
}

.state-card {
  padding: 34rpx 28rpx;
  margin-top: 20rpx;
}

.error-card {
  border-color: #F0D6DC;
  background: #FFF8FA;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
}

.error-card .state-title {
  color: #D94B73;
}

.state-desc {
  margin-top: 12rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.55;
}

.retry-button {
  width: 160rpx;
  margin-top: 22rpx;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.review-card {
  padding: 26rpx;
}

.review-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.review-status {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.review-reason {
  margin-top: 8rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.meal-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8B6CFF;
  background: #EEE8FF;
  font-size: 22rpx;
  font-weight: 700;
}

.review-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
}

.review-thumb {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: #FAF8F5;
}

.review-copy {
  flex: 1;
  min-width: 0;
}

.food-summary {
  color: #25232A;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.food-kcal {
  margin-top: 10rpx;
  color: #807987;
  font-size: 24rpx;
}

.review-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.review-field {
  min-height: 92rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
}

.field-label {
  display: block;
  color: #807987;
  font-size: 22rpx;
  line-height: 1.25;
}

.field-value {
  display: block;
  margin-top: 10rpx;
  color: #25232A;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-all;
}

.review-meta-list {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0ECE7;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 44rpx;
}

.meta-row + .meta-row {
  margin-top: 8rpx;
}

.meta-label {
  flex-shrink: 0;
  color: #807987;
  font-size: 23rpx;
}

.meta-value {
  color: #25232A;
  font-size: 23rpx;
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}

.review-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0ECE7;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 72rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.approve-button {
  color: #FFFFFF;
  background: #8B6CFF;
}

.reject-button {
  color: #D94B73;
  background: #FFF0F4;
  border: 1rpx solid #F0D6DC;
}

.action-button[disabled] {
  opacity: 0.6;
}
