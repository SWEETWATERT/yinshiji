<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.08;"></image>
</view>

<view class="page page-container admin-config-page">
  <brand-header></brand-header>

  <view class="config-header">
    <view>
      <view class="page-title">{{title}}</view>
      <view class="page-subtitle">{{desc}}</view>
    </view>
    <view class="header-actions">
      <button class="refresh-button" bindtap="refreshConfig" disabled="{{loading || saving}}">
        {{loading ? '加载中' : '刷新'}}
      </button>
      <button class="save-button" bindtap="saveConfig" disabled="{{loading || saving}}">
        {{saving ? '保存中' : '保存'}}
      </button>
    </view>
  </view>

  <view class="section-card config-summary">
    <view class="summary-label">配置项</view>
    <view class="summary-value-row">
      <text class="summary-value">{{configFieldCount}}</text>
      <text class="summary-unit">项</text>
    </view>
    <view class="summary-desc">云端记录 {{records.length}} 条，更新时间：{{updatedAt}}</view>
  </view>

  <view wx:if="{{loading}}" class="section-card state-card">
    <view class="state-title">加载中</view>
    <view class="state-desc">正在读取 app_config 系统配置。</view>
  </view>

  <view wx:elif="{{error}}" class="section-card state-card error-card">
    <view class="state-title">{{error}}</view>
    <view class="state-desc">请确认当前账号有后台权限，且 adminApi 云函数已部署。</view>
    <button class="retry-button" bindtap="refreshConfig">重试</button>
  </view>

  <view wx:else>
    <view class="section-card config-tools">
      <view>
        <view class="tools-title">当前配置</view>
        <view class="tools-desc">修改后点击保存写入 app_config.default。</view>
      </view>
      <button class="reset-button" bindtap="resetDefaultConfig" disabled="{{saving}}">恢复默认</button>
    </view>

    <block wx:for="{{sections}}" wx:key="title">
      <view class="section-card config-section">
        <view class="card-title">{{item.title}}</view>
        <view class="card-desc">{{item.desc}}</view>

        <view class="field-list">
          <block wx:for="{{item.fields}}" wx:key="key" wx:for-item="field">
            <view class="config-field {{field.isTextarea ? 'textarea-field' : ''}}">
              <view class="field-main">
                <text class="config-label">{{field.label}}</text>
                <text wx:if="{{field.unit}}" class="config-unit">{{field.unit}}</text>
              </view>

              <switch
                wx:if="{{field.isSwitch}}"
                checked="{{field.value}}"
                color="#8B6CFF"
                data-key="{{field.key}}"
                bindchange="onSwitchChange"
              />

              <textarea
                wx:elif="{{field.isTextarea}}"
                class="config-textarea"
                value="{{field.value}}"
                data-key="{{field.key}}"
                bindinput="onFieldInput"
                maxlength="240"
                auto-height
              />

              <input
                wx:else
                class="config-input"
                type="{{field.inputType}}"
                value="{{field.value}}"
                data-key="{{field.key}}"
                bindinput="onFieldInput"
              />
            </view>
          </block>
        </view>
      </view>
    </block>

    <view class="section-card raw-card">
      <view class="card-title">即将保存的 JSON</view>
      <text class="raw-json">{{rawPreview}}</text>
    </view>
  </view>
</view>
