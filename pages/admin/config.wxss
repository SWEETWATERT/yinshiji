.admin-config-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.config-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.header-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.refresh-button,
.retry-button,
.save-button,
.reset-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 116rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #8B6CFF;
  background: #EEE8FF;
  font-size: 24rpx;
  font-weight: 700;
}

.save-button {
  color: #FFFFFF;
  background: #8B6CFF;
}

.reset-button {
  min-width: 132rpx;
  color: #807987;
  background: #FAF8F5;
}

.refresh-button[disabled],
.save-button[disabled],
.reset-button[disabled] {
  opacity: 0.6;
}

.config-summary {
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.summary-label {
  color: #807987;
  font-size: 24rpx;
}

.summary-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 12rpx;
}

.summary-value {
  color: #25232A;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-unit {
  color: #807987;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-desc {
  margin-top: 14rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-card {
  padding: 34rpx 28rpx;
  margin-top: 20rpx;
}

.error-card {
  border-color: #F0D6DC;
  background: #FFF8FA;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
}

.error-card .state-title {
  color: #D94B73;
}

.state-desc {
  margin-top: 12rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.55;
}

.retry-button {
  width: 160rpx;
  margin-top: 22rpx;
}

.config-tools,
.config-section,
.raw-card {
  padding: 26rpx;
  margin-top: 20rpx;
}

.config-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.tools-title {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.tools-desc,
.card-desc {
  margin-top: 8rpx;
  color: #807987;
  font-size: 23rpx;
  line-height: 1.45;
}

.card-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-list {
  margin-top: 18rpx;
}

.config-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 82rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0ECE7;
}

.config-field:last-child {
  border-bottom: 0;
}

.textarea-field {
  display: block;
}

.field-main {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.config-label {
  color: #807987;
  font-size: 24rpx;
}

.config-unit {
  color: #AEA7B3;
  font-size: 21rpx;
}

.config-input {
  flex: 1;
  min-width: 220rpx;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  color: #25232A;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
  box-sizing: border-box;
}

.config-textarea {
  width: 100%;
  min-height: 112rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  color: #25232A;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.raw-json {
  display: block;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  color: #5F5868;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
  font-size: 22rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}
