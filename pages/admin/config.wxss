.admin-config-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.config-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.refresh-button,
.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 116rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #8B6CFF;
  background: #EEE8FF;
  font-size: 24rpx;
  font-weight: 700;
}

.refresh-button[disabled] {
  opacity: 0.6;
}

.config-summary {
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.summary-label {
  color: #807987;
  font-size: 24rpx;
}

.summary-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 12rpx;
}

.summary-value {
  color: #25232A;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-unit {
  color: #807987;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-desc {
  margin-top: 14rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-card {
  padding: 34rpx 28rpx;
  margin-top: 20rpx;
}

.error-card {
  border-color: #F0D6DC;
  background: #FFF8FA;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
}

.error-card .state-title {
  color: #D94B73;
}

.state-desc {
  margin-top: 12rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.55;
}

.retry-button {
  width: 160rpx;
  margin-top: 22rpx;
}

.config-card,
.raw-card {
  padding: 26rpx;
  margin-top: 20rpx;
}

.card-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.config-list {
  margin-top: 18rpx;
}

.config-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 70rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0ECE7;
}

.config-row:last-child {
  border-bottom: 0;
}

.config-label {
  flex-shrink: 0;
  color: #807987;
  font-size: 24rpx;
}

.config-value {
  color: #25232A;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
  word-break: break-all;
}

.raw-json {
  display: block;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  color: #5F5868;
  background: #FAF8F5;
  border: 1rpx solid #EFE7DE;
  font-size: 22rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}
