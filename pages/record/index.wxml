<view class="page page-container record-page">
  <view class="page-title">记录这一餐</view>
  <view class="page-subtitle">拍照或从相册选择餐食照片</view>

  <view class="section-card meal-section">
    <view class="section-title">餐次</view>
    <view class="chip-row">
      <block wx:for="{{mealTypes}}" wx:key="type">
        <view class="chip {{selectedMeal === item.type ? 'chip-active' : ''}}" data-type="{{item.type}}" bindtap="selectMeal">
          <text class="chip-icon">{{item.icon}}</text>
          <text>{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section-card upload-card">
    <view class="section-title">餐食照片</view>
    <button class="upload-box" bindtap="chooseFromAlbum">
      <image wx:if="{{imagePath}}" class="upload-image" src="{{imagePath}}" mode="aspectFill"></image>
      <view wx:else class="upload-empty">
        <text class="upload-icon">📷</text>
        <text class="upload-title">上传或拍摄餐食照片</text>
        <text class="upload-hint">用于模拟识别食物和营养估算</text>
      </view>
    </button>
    <view class="upload-actions">
      <button class="upload-action" bindtap="takePhoto">拍下这一餐</button>
      <button class="upload-action" bindtap="chooseFromAlbum">从相册选择</button>
    </view>
  </view>

  <view class="section-card note-card">
    <view class="section-title">备注</view>
    <view class="chip-row">
      <block wx:for="{{noteTags}}" wx:key="*this">
        <view class="chip {{note === item ? 'chip-active' : ''}}" data-note="{{item}}" bindtap="setNote">{{item}}</view>
      </block>
    </view>
    <textarea class="note-input" value="{{note}}" bindinput="onNoteInput" placeholder="例如：少油、半碗饭、无糖"></textarea>
  </view>

  <view class="fixed-bottom-button action-bottom">
    <button class="primary-button analyze-button" bindtap="startAnalyze">开始分析</button>
  </view>
</view>
