<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.10;"></image>
</view>
<view class="page page-container record-page">

  <!-- Brand Header -->
  <brand-header></brand-header>

  <!-- Header -->
  <view class="page-title">记录这一餐</view>
  <view class="page-subtitle">拍照或从相册选择，系统会帮你估算营养</view>

  <!-- Meal Type Pills -->
  <view class="meal-type-wrap">
    <block wx:for="{{mealTypes}}" wx:key="type">
      <view
        class="meal-pill {{selectedMeal === item.type ? 'meal-pill-active' : ''}}"
        data-type="{{item.type}}"
        bindtap="selectMeal"
      >
        <text class="pill-icon">{{item.icon}}</text>
        <text class="pill-label">{{item.label}}</text>
      </view>
    </block>
  </view>

  <!-- Camera Upload Card -->
  <view class="upload-card section-card">
    <view class="upload-zone" bindtap="takePhoto">
      <block wx:if="{{imagePath}}">
        <image class="upload-preview" src="{{imagePath}}" mode="aspectFit"></image>
      </block>
      <block wx:else>
        <view class="cam-wrap">
          <view class="cam-body">
            <view class="cam-lens"></view>
          </view>
        </view>
        <text class="upload-title">点击拍照或上传餐食照片</text>
        <text class="upload-hint">尽量拍清楚食物和份量，结果会更准确</text>
      </block>
    </view>
    <view class="upload-actions">
      <button class="btn-take primary-button" bindtap="takePhoto">拍照</button>
      <button class="btn-album btn-ghost" bindtap="chooseFromAlbum">从相册选择</button>
    </view>
  </view>

  <!-- Note Section -->
  <view class="note-card section-card">
    <view class="note-head">小备注</view>
    <view class="note-chips">
      <block wx:for="{{noteTags}}" wx:key="*this">
        <view
          class="chip {{note === item ? 'chip-active' : ''}}"
          data-note="{{item}}"
          bindtap="setNote"
        >{{item}}</view>
      </block>
    </view>
    <view class="note-label">今天这餐有什么特别？</view>
    <textarea
      class="note-input"
      value="{{note}}"
      bindinput="onNoteInput"
      placeholder="比如少油少盐、米饭半碗、无糖饮品…"
      placeholder-class="note-placeholder"
      maxlength="100"
      auto-height
    ></textarea>
  </view>

  <!-- Fixed Analyze Button -->
  <view class="fixed-bottom-button">
    <button
      class="primary-button {{imagePath ? '' : 'primary-button-disabled'}}"
      bindtap="startAnalyze"
      disabled="{{uploading}}"
    >
      <block wx:if="{{uploading}}">上传中…</block>
      <block wx:elif="{{imagePath}}">开始分析</block>
      <block wx:else>先上传一张餐食照片</block>
    </button>
  </view>

</view>
