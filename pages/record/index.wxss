.record-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

/* ── Page Header ── */
.record-page .page-title {
  margin-bottom: 6rpx;
}

.record-page .page-subtitle {
  margin-bottom: 28rpx;
}

/* ── Meal Type Pills ── */
.meal-type-wrap {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.meal-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 64rpx;
  border-radius: 999rpx;
  color: #807987;
  font-size: 26rpx;
  font-weight: 500;
  background: #FFFFFF;
  border: 1.5rpx solid #E9E1D8;
}

.meal-pill-active {
  color: #fff;
  background: #8B6CFF;
  border-color: #8B6CFF;
  box-shadow: 0 4rpx 14rpx rgba(139, 108, 255, 0.28);
}

.pill-icon {
  font-size: 28rpx;
  line-height: 1;
}

.pill-label {
  font-size: 26rpx;
  font-weight: 500;
}

/* ── Upload Card ── */
.upload-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.upload-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #C4B8D0;
  background: #F7F2EA;
  overflow: hidden;
  gap: 16rpx;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

/* CSS Camera Icon */
.cam-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #EEE8FF;
}

.cam-body {
  position: relative;
  width: 72rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border: 4rpx solid #8B6CFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cam-body::before {
  content: "";
  position: absolute;
  top: -12rpx;
  left: 16rpx;
  width: 22rpx;
  height: 10rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #8B6CFF;
}

.cam-lens {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #8B6CFF;
}

.upload-title {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.upload-hint {
  color: #807987;
  font-size: 26rpx;
  text-align: center;
}

.upload-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-take {
  min-height: 88rpx;
  font-size: 28rpx;
}

.btn-album {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 14rpx;
  color: #8B6CFF;
  font-size: 28rpx;
  font-weight: 600;
  background: #EEE8FF;
  border: 1.5rpx solid rgba(139, 108, 255, 0.25);
}

/* ── Note Card ── */
.note-card {
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
}

.note-head {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.note-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.note-label {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.note-input {
  width: 100%;
  min-height: 100rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  color: #25232A;
  font-size: 28rpx;
  line-height: 1.55;
  background: #F7F2EA;
  border: 1.5rpx solid #E9E1D8;
}

.note-placeholder {
  color: #C4B8D0;
  font-size: 26rpx;
}
