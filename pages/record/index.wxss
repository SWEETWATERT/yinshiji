.record-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.meal-section,
.upload-card,
.note-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 18rpx;
}

.record-page .chip {
  flex: 0 0 auto;
}

.chip-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  font-size: 40rpx;
  line-height: 1;
}

.upload-box {
  width: 100%;
  height: 248rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border: 2rpx dashed #ded8e4;
  border-radius: 20rpx;
  background: #faf7f8;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #8c8498;
  text-align: center;
}

.upload-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  font-size: 72rpx;
  line-height: 1;
  background: #fff;
}

.upload-title {
  margin-top: 16rpx;
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 500;
}

.upload-hint {
  margin-top: 8rpx;
  color: #8c8498;
  font-size: 24rpx;
}

.upload-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.upload-action {
  height: 72rpx;
  min-height: 72rpx;
  border-radius: 18rpx;
  color: #5f576a;
  font-size: 26rpx;
  background: #f3f1f5;
}

.note-input {
  width: 100%;
  min-height: 104rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #2f2936;
  font-size: 26rpx;
  line-height: 1.45;
  background: #faf7f8;
}

.action-bottom {
  bottom: calc(86rpx + env(safe-area-inset-bottom));
  margin-top: 0;
}

.analyze-button {
  width: 520rpx;
  height: 88rpx;
}
