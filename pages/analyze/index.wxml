<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.08;"></image>
</view>

<view class="page page-container analyze-page analyze-processing-page">
  <view class="processing-card section-card">
    <view class="processing-ring">
      <view class="loading-spinner"></view>
    </view>
    <view class="processing-title">AI分析中</view>
    <view class="processing-desc">
      系统正在识别食物、匹配 food_items 营养库，并生成本餐AI结论。
    </view>
    <view class="processing-steps">
      <view class="processing-step">识别餐食内容</view>
      <view class="processing-step">匹配食物库</view>
      <view class="processing-step">生成评分与建议</view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-card section-card processing-error">
    <text class="error-title">AI分析暂时失败</text>
    <text class="error-text">{{errorMessage}}</text>
    <button class="mini-primary" bindtap="goBack">返回</button>
  </view>
</view>
