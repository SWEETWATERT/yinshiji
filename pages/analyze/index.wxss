.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 28rpx;
  color: #6f5acb;
  font-size: 54rpx;
  line-height: 64rpx;
  background: rgba(255,255,255,.75);
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx;
}

.soft-label {
  color: #8d7d91;
  font-size: 24rpx;
  font-weight: 800;
}

.kcal {
  margin-top: 10rpx;
  font-size: 82rpx;
  line-height: 1;
  font-weight: 900;
}

.kcal text {
  color: #8d7d91;
  font-size: 26rpx;
}

.score-pill {
  padding: 18rpx 26rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ff9ec7, #9c8bea);
}

.macro-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin: 24rpx 0;
}

.macro-card {
  padding: 26rpx;
}

.macro-card text {
  color: #8d7d91;
  font-size: 24rpx;
  font-weight: 800;
}

.macro-card strong {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
}

.food-list {
  display: grid;
  gap: 18rpx;
}

.food-card {
  display: grid;
  grid-template-columns: 84rpx 1fr 144rpx;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
}

.food-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 30rpx;
  font-size: 42rpx;
  background: linear-gradient(135deg, #bfe8d5, #c9c0f6);
}

.food-name {
  font-size: 30rpx;
  font-weight: 900;
}

.food-sub {
  margin-top: 8rpx;
  color: #8d7d91;
  font-size: 24rpx;
}

.food-actions {
  display: flex;
  gap: 12rpx;
}

.food-actions button {
  width: 58rpx;
  height: 58rpx;
  border-radius: 22rpx;
  color: #6f5acb;
  font-size: 34rpx;
  background: rgba(255,255,255,.78);
}

.advice-card {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 28rpx;
}

.helper {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 92rpx;
  height: 92rpx;
  border-radius: 32rpx;
  font-size: 44rpx;
  background: linear-gradient(135deg, #ff9ec7, #9c8bea 58%, #9fe7cc);
}

.section-title {
  font-size: 30rpx;
  font-weight: 900;
}

.advice {
  margin-top: 8rpx;
  color: #8d7d91;
  font-size: 26rpx;
  line-height: 1.55;
}

.save-button {
  margin-top: 28rpx;
}
