.analyze-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.summary-card {
  padding: 28rpx;
}

.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.score-pill {
  flex: 0 0 auto;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 52rpx;
  background: linear-gradient(135deg, #f58bb8 0%, #8d7cf0 100%);
}

.kcal-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 22rpx;
  white-space: nowrap;
}

.kcal {
  color: #2f2936;
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1;
}

.kcal-unit {
  color: #8c8498;
  font-size: 26rpx;
}

.macro-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.macro-item {
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  background: #faf7f8;
}

.macro-label {
  display: block;
  color: #8c8498;
  font-size: 24rpx;
}

.macro-value {
  display: block;
  margin-top: 8rpx;
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 600;
}

.section-block {
  margin-top: 28rpx;
}

.food-list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.food-card {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr) 116rpx;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 18rpx;
}

.food-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1;
  background: #f3f1f5;
}

.food-main {
  min-width: 0;
}

.food-name {
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-sub {
  margin-top: 6rpx;
  color: #8c8498;
  font-size: 24rpx;
  white-space: nowrap;
}

.food-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
}

.food-action-button {
  width: 50rpx;
  height: 50rpx;
  border-radius: 18rpx;
  color: #6d5fd5;
  font-size: 28rpx;
  line-height: 50rpx;
  background: #f3f1f5;
}

.advice-card {
  margin-top: 28rpx;
  padding: 28rpx;
}

.advice {
  margin-top: 12rpx;
  color: #5f576a;
  font-size: 26rpx;
  line-height: 1.6;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  padding-top: 28rpx;
  padding-bottom: 0;
  background: linear-gradient(180deg, rgba(247,248,250,0), #f7f8fa 34%);
  z-index: 10;
}

.save-button {
  width: 520rpx;
}
