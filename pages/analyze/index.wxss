/* ── Page ── */
.analyze-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.analyze-processing-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
}

.processing-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58rpx 36rpx;
  text-align: center;
  border-color: #dfeee5;
  background: #fbfdfc;
}

.processing-ring {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #f4faf6;
  border: 1rpx solid #dfeee5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.processing-title {
  margin-top: 28rpx;
  color: #24362d;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.processing-desc {
  margin-top: 14rpx;
  color: #5f6762;
  font-size: 26rpx;
  line-height: 1.6;
}

.processing-steps {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 30rpx;
}

.processing-step {
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  color: #256850;
  background: #e8f5ef;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.processing-error {
  margin-top: 20rpx;
}

/* ── Meal Photo ── */
.meal-photo-card {
  margin-bottom: 20rpx;
  overflow: hidden;
  padding: 0;
  background: #F7F2EA;
}

.meal-photo-img {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #F7F2EA;
}

.meal-photo-label {
  padding: 14rpx 20rpx;
  color: #807987;
  font-size: 22rpx;
}

.no-photo-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
  background: #fff8ec;
  border: 1rpx solid #f5d48a;
}

.no-photo-icon {
  font-size: 32rpx;
  flex: 0 0 auto;
}

.no-photo-text {
  color: #7a5500;
  font-size: 24rpx;
  line-height: 1.5;
}

/* ── Nav ── */
.analyze-nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.nav-back-btn {
  flex: 0 0 auto;
  padding: 0 20rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.7);
  color: #5f576a;
  font-size: 26rpx;
  border: none;
  box-shadow: none;
}

.analyze-title {
  color: #2f2936;
  font-size: 32rpx;
  font-weight: 700;
}

/* ── Loading ── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 32rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e9e1f8;
  border-top-color: #8b6cff;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #8c8498;
  font-size: 26rpx;
}

/* ── Warnings ── */
.warning-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #fff8ec;
  border: 1rpx solid #f5d48a;
}

.warning-icon {
  flex: 0 0 auto;
  font-size: 28rpx;
  line-height: 1.4;
}

.warning-text {
  flex: 1;
  color: #7a5500;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ── Summary Card ── */
.summary-card {
  padding: 28rpx;
}

.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.score-pill {
  flex: 0 0 auto;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 52rpx;
  background: linear-gradient(135deg, #8b6cff 0%, #6eb8a0 100%);
}

.macro-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.macro-item {
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #faf7f8;
  text-align: center;
}

.macro-label {
  display: block;
  color: #8c8498;
  font-size: 22rpx;
}

.macro-value {
  display: block;
  margin-top: 6rpx;
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 600;
}

/* ── Section Header ── */
.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  margin-bottom: 16rpx;
}

.food-list-hd {
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 700;
}

.add-food-btn {
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: #8b6cff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* ── Empty State ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  gap: 14rpx;
}

.empty-icon {
  font-size: 52rpx;
}

.empty-text {
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-hint {
  color: #8c8498;
  font-size: 24rpx;
}

/* ── Food List ── */
.food-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.food-card {
  padding: 20rpx 20rpx 16rpx;
}

.card-unconfirmed {
  border: 1rpx solid #f5d48a;
  background: #fffcf5;
}

.food-row-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.food-icon-box {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #f3f1f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
}

.food-main {
  flex: 1;
  min-width: 0;
}

.food-name {
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-sub {
  margin-top: 6rpx;
  color: #8c8498;
  font-size: 22rpx;
  white-space: nowrap;
}

.food-confidence {
  display: inline-flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f5f1ff;
  color: #7b66d9;
  font-size: 20rpx;
  line-height: 1.3;
  max-width: 100%;
}

.confirm-badge {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fff4df;
  color: #b87a00;
  font-size: 20rpx;
  font-weight: 500;
}

.delete-btn {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f3f1f5;
  color: #8c8498;
  font-size: 28rpx;
  line-height: 44rpx;
  padding: 0;
  border: none;
  box-shadow: none;
  text-align: center;
}

.food-row-weight {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0ecf4;
}

.weight-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #f3f1f5;
  color: #5f4faa;
  font-size: 30rpx;
  line-height: 52rpx;
  padding: 0;
  border: none;
  box-shadow: none;
  text-align: center;
}

.weight-val {
  min-width: 80rpx;
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

/* ── Advice Card ── */
.advice-card {
  padding: 24rpx 26rpx;
}

.advice-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.advice-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #6eb87a;
  flex: 0 0 auto;
}

.advice-title {
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 700;
}

.advice-body {
  color: #5f576a;
  font-size: 26rpx;
  line-height: 1.7;
}

/* ── Save Bar ── */
.save-bar {
  bottom: calc(20rpx + env(safe-area-inset-bottom)) !important;
}

.save-button {
  width: 560rpx;
}

/* ── Search Panel ── */
.search-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 100;
}

.search-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 75vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.search-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0ecf4;
  flex: 0 0 auto;
}

.search-title {
  color: #2f2936;
  font-size: 30rpx;
  font-weight: 700;
}

.search-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f3f1f5;
  color: #8c8498;
  font-size: 32rpx;
  line-height: 52rpx;
  padding: 0;
  border: none;
  box-shadow: none;
  text-align: center;
}

.search-input {
  margin: 20rpx 32rpx;
  padding: 0 24rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #f5f3f8;
  color: #2f2936;
  font-size: 28rpx;
  flex: 0 0 auto;
}

.search-submit {
  margin: 0 32rpx 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 20rpx;
  border: none;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #e879b7 0%, #8b6cff 100%);
  box-shadow: 0 10rpx 22rpx rgba(139, 108, 255, 0.18);
}

.search-submit[disabled] {
  opacity: 0.72;
}

.search-placeholder {
  color: #b0aab8;
}

.search-results {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 0 16rpx;
}

.search-empty {
  padding: 40rpx 32rpx;
  color: #8c8498;
  font-size: 26rpx;
  text-align: center;
}

.search-error {
  color: #b4475a;
}

.search-result-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
}

.search-result-item:active {
  background: #f8f5ff;
}

.sri-icon {
  flex: 0 0 auto;
  font-size: 36rpx;
  width: 52rpx;
  text-align: center;
}

.sri-info {
  flex: 1;
  min-width: 0;
}

.sri-name {
  display: block;
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 600;
}

.sri-cal {
  display: block;
  margin-top: 4rpx;
  color: #8c8498;
  font-size: 22rpx;
}

.sri-add {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #8b6cff;
  color: #fff;
  font-size: 30rpx;
  line-height: 48rpx;
  text-align: center;
}


/* ── v0.4 confirmation additions ── */
.error-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #ffd6df;
  background: #fff7f9;
}

.error-title {
  display: block;
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 700;
}

.error-text {
  display: block;
  margin-top: 10rpx;
  color: #8c4b5a;
  font-size: 24rpx;
  line-height: 1.6;
}

.recognition-card {
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
}

.recognition-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 0;
}

.recognition-row.subtle {
  opacity: 0.82;
}

.recognition-label {
  color: #8c8498;
  font-size: 24rpx;
}

.recognition-value {
  color: #2f2936;
  font-size: 25rpx;
  font-weight: 600;
  text-align: right;
}

.review-tip {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #8a5d00;
  background: #fff6dc;
  font-size: 24rpx;
  line-height: 1.5;
}

/* ── AI Result Panel ── */
.ai-result-panel {
  display: flex;
  flex-direction: column;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e7edf0;
  background: #fbfdfc;
}

.ai-result-warning {
  border-color: #f5d48a;
  background: #fffcf5;
}

.ai-panel-head {
  order: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.ai-panel-title {
  color: #2f2936;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.ai-panel-subtitle {
  margin-top: 10rpx;
  color: #5f6762;
  font-size: 24rpx;
  line-height: 1.55;
}

.ai-source-pill {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #e8f5ef;
  font-size: 22rpx;
  font-weight: 700;
}

.ai-warning-bar {
  order: 0;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #8a5d00;
  background: #fff1c7;
  font-size: 24rpx;
  line-height: 1.5;
}

.ai-score-card {
  order: 3;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f4faf6;
  border: 1rpx solid #dfeee5;
}

.ai-conclusion-card {
  border-color: #cfe8d9;
}

.ai-score-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.ai-score-label {
  color: #24362d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
}

.ai-score-desc {
  margin-top: 8rpx;
  color: #5f6762;
  font-size: 23rpx;
  line-height: 1.55;
}

.ai-score-badge {
  flex: 0 0 126rpx;
  min-height: 126rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #d9ebe0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ai-score-num {
  color: #256850;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.ai-score-unit {
  margin-top: 4rpx;
  color: #7a837f;
  font-size: 20rpx;
}

.ai-score-grade {
  margin-top: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #58a27f;
  font-size: 20rpx;
  font-weight: 700;
}

.ai-score-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.ai-score-item {
  min-width: 0;
  padding: 12rpx 8rpx;
  border-radius: 14rpx;
  background: #ffffff;
  text-align: center;
}

.ai-score-item-label {
  display: block;
  color: #7a837f;
  font-size: 18rpx;
  line-height: 1.25;
  word-break: break-all;
}

.ai-score-item-value {
  display: block;
  margin-top: 6rpx;
  color: #24362d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
}

.ai-field-grid {
  order: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.ai-report-section-title {
  order: 1;
  margin-top: 22rpx;
  color: #24362d;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.ai-recognition-title {
  margin-top: 20rpx;
}

.ai-field {
  min-width: 0;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f5f7f6;
  border: 1rpx solid #e9eeeb;
}

.ai-field-label {
  display: block;
  color: #7a837f;
  font-size: 20rpx;
  line-height: 1.25;
}

.ai-field-value {
  display: block;
  margin-top: 8rpx;
  color: #2f2936;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.ai-block {
  order: 5;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e9eeeb;
}

.ai-block-title {
  color: #2f2936;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
}

.ai-process-toggle {
  order: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 18rpx 0 0;
  border-top: 1rpx solid #e9eeeb;
}

.ai-process-subtitle {
  margin-top: 6rpx;
  color: #7a837f;
  font-size: 22rpx;
  line-height: 1.35;
}

.ai-process-action {
  flex: 0 0 auto;
  color: #256850;
  font-size: 23rpx;
  font-weight: 800;
}

.ai-process-body {
  order: 2;
  border-top: 0;
  padding-top: 4rpx;
}

.ai-advice-report {
  order: 4;
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fffcfe;
  border: 1rpx solid rgba(139, 108, 255, 0.16);
}

.ai-advice-report .ai-report-section-title {
  margin-top: 0;
}

.ai-advice-report-text {
  margin-top: 12rpx;
  color: #4c3e62;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.6;
}

.ai-process-step {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ai-process-copy {
  flex: 1;
  min-width: 0;
}

.ai-process-title {
  color: #24362d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.ai-process-chain {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f5f7f6;
}

.ai-process-line {
  position: relative;
  padding-left: 20rpx;
  margin-top: 8rpx;
  color: #5f6762;
  font-size: 22rpx;
  line-height: 1.55;
}

.ai-process-line:first-child {
  margin-top: 0;
}

.ai-process-line::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #58a27f;
}

.ai-step {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.ai-step-index {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #58a27f;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.ai-step-text {
  flex: 1;
  color: #5f6762;
  font-size: 23rpx;
  line-height: 1.55;
}

.ai-candidate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef2ef;
}

.ai-candidate-row:last-child {
  border-bottom: 0;
}

.ai-candidate-name {
  color: #2f2936;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ai-candidate-meta {
  margin-top: 4rpx;
  color: #7a837f;
  font-size: 21rpx;
  line-height: 1.35;
}

.ai-candidate-score {
  flex: 0 0 auto;
  color: #256850;
  font-size: 23rpx;
  font-weight: 800;
}

.ai-detected-pill {
  display: inline-flex;
  max-width: 100%;
  margin: 12rpx 10rpx 0 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #4b5e57;
  background: #edf6f1;
  font-size: 22rpx;
  line-height: 1.35;
}

.ai-warning-item,
.ai-empty-line {
  margin-top: 12rpx;
  color: #7a837f;
  font-size: 23rpx;
  line-height: 1.55;
}

.ai-warning-item {
  color: #8a5d00;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 0 0 auto;
}

.add-food-btn.ghost {
  color: #7b66d9;
  background: #f1ecff;
}

.mini-primary {
  margin-top: 18rpx;
  min-width: 220rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #e36fb0 0%, #8b6cff 100%);
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  box-shadow: none;
}

.food-name-input {
  width: 100%;
  min-height: 44rpx;
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 700;
}

.food-placeholder {
  color: #b9b2c3;
  font-weight: 500;
}

.nutrition-missing {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #8a5d00;
  background: #fff6dc;
  font-size: 22rpx;
  line-height: 1.45;
}

.food-ai-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 0 0;
  border-top: 1rpx solid #f0ecf4;
}

.food-ai-title {
  color: #2f2936;
  font-size: 24rpx;
  font-weight: 800;
}

.food-ai-warning {
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #8a5d00;
  background: #fff1c7;
  font-size: 20rpx;
  font-weight: 700;
}

.food-ai-toggle-text {
  flex: 0 0 auto;
  color: #7b66d9;
  font-size: 23rpx;
  font-weight: 700;
}

.food-ai-detail {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fbfdfc;
  border: 1rpx solid #e7edf0;
}

.food-ai-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.food-ai-field {
  min-width: 0;
  padding: 12rpx;
  border-radius: 14rpx;
  background: #f5f7f6;
}

.food-ai-label {
  display: block;
  color: #7a837f;
  font-size: 19rpx;
  line-height: 1.25;
}

.food-ai-value {
  display: block;
  margin-top: 6rpx;
  color: #2f2936;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.food-ai-chain {
  margin-top: 14rpx;
}

.food-ai-step {
  position: relative;
  padding-left: 22rpx;
  margin-top: 10rpx;
  color: #5f6762;
  font-size: 22rpx;
  line-height: 1.55;
}

.food-ai-step::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #58a27f;
}

.weight-label {
  margin-right: auto;
  color: #8c8498;
  font-size: 24rpx;
}

.weight-input {
  width: 108rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  border: 1rpx solid #ece6f2;
}

.weight-unit {
  color: #8c8498;
  font-size: 24rpx;
  margin-left: -12rpx;
}
