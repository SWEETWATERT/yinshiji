<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.08;"></image>
</view>
<view class="page page-container report-page">

  <!-- Brand Header -->
  <brand-header></brand-header>

  <!-- Page Header -->
  <view class="report-hd">
    <view class="page-title">本周营养报告</view>
    <view class="page-subtitle">{{weekRange}}</view>
  </view>

  <!-- ── Score Hero Card ── -->
  <view class="hero-card section-card">
    <view class="hero-left">
      <view class="score-ring">
        <text class="score-num">{{avgScore}}</text>
        <text class="score-unit-sm">分</text>
      </view>
      <view class="grade-badge">{{grade}}</view>
    </view>
    <view class="hero-divider"></view>
    <view class="hero-right">
      <view class="hero-stat-item">
        <text class="hsi-val">{{avgKcal}}</text>
        <text class="hsi-unit"> kcal</text>
        <text class="hsi-label">日均热量</text>
      </view>
      <view class="hero-stat-sep"></view>
      <view class="hero-stat-item">
        <text class="hsi-val">{{proteinRate}}</text>
        <text class="hsi-unit">%</text>
        <text class="hsi-label">蛋白达标率</text>
      </view>
    </view>
  </view>

  <!-- ── 7-Day Calorie Trend ── -->
  <view class="trend-card section-card">
    <view class="card-hd">
      <text class="card-title">热量趋势</text>
      <text class="card-meta">均 {{avgKcal}} kcal/天</text>
    </view>
    <view class="bars-wrap">
      <block wx:for="{{bars}}" wx:key="index">
        <view class="bar-col">
          <view class="bar-outer">
            <view
              class="bar-inner {{item.isToday ? 'bar-today' : ''}} {{item.hasData ? '' : 'bar-empty'}}"
              style="height:{{item.pct}}%;"
            ></view>
          </view>
          <text class="bar-label {{item.isToday ? 'label-today' : ''}}">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- ── Macro Breakdown ── -->
  <view class="section-hd-row">
    <text class="section-title">每日平均摄入</text>
  </view>
  <view class="macro-card section-card">
    <block wx:for="{{macros}}" wx:key="name">
      <view class="macro-row {{index > 0 ? 'macro-border' : ''}}">
        <view class="macro-left">
          <view class="macro-dot dot-{{item.color}}"></view>
          <text class="macro-name">{{item.name}}</text>
        </view>
        <view class="macro-mid">
          <view class="macro-bar-bg">
            <view class="macro-bar-fill fill-{{item.color}}" style="width:{{item.pct}}%;"></view>
          </view>
        </view>
        <view class="macro-right">
          <text class="macro-val">{{item.val}}{{item.unit}}</text>
          <text class="macro-cap"> / {{item.target}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- ── Behavior Stats 2×2 ── -->
  <view class="section-hd-row">
    <text class="section-title">饮食行为</text>
  </view>
  <view class="stat-grid">
    <block wx:for="{{stats}}" wx:key="label">
      <view class="stat-cell section-card">
        <text class="stat-emoji">{{item.icon}}</text>
        <text class="stat-val">{{item.value}}</text>
        <text class="stat-lbl">{{item.label}}</text>
      </view>
    </block>
  </view>

  <!-- ── AI Insight ── -->
  <view class="insight-card section-card">
    <view class="insight-hd">
      <view class="insight-dot"></view>
      <text class="insight-title">AI 周度建议</text>
    </view>
    <text class="insight-body">{{summary}}</text>
  </view>

</view>
