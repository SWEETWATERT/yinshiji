<view class="page report-page">
  <view class="page-title">营养报告</view>
  <view class="page-subtitle">最近 7 天饮食趋势</view>

  <view class="score-card glass-card">
    <view>
      <view class="soft-label">本周平均健康评分</view>
      <view class="score">{{averageScore}}</view>
      <view class="muted">分 · 平均 {{averageCalories}} kcal</view>
    </view>
    <view class="score-ring">★</view>
  </view>

  <view class="trend-card glass-card">
    <view class="card-head">
      <text>热量趋势</text>
      <text>近 7 天</text>
    </view>
    <view class="bars">
      <block wx:for="{{calorieBars}}" wx:key="index">
        <view class="bar" style="height: {{item}}%;"></view>
      </block>
    </view>
  </view>

  <view class="protein-card glass-card">
    <view class="card-head">
      <text>蛋白质达标率</text>
      <text>{{proteinRate}}%</text>
    </view>
    <view class="progress"><view class="progress-inner" style="width: {{proteinRate}}%;"></view></view>
  </view>

  <view class="stat-grid">
    <block wx:for="{{stats}}" wx:key="label">
      <view class="stat-card glass-card">
        <view class="stat-icon">{{item.icon}}</view>
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </block>
  </view>

  <view class="advice-card glass-card">
    <view class="helper">✨</view>
    <view>
      <view class="section-title">本周建议</view>
      <view class="advice">{{summary}}</view>
    </view>
  </view>
</view>
