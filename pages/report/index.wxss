/* ── Page: non-tab page, smaller bottom clearance ── */
.report-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ── Page Header ── */
.report-hd {
  margin-bottom: 24rpx;
}

/* ── Hero Card ── */
.hero-card {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.hero-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  flex: 0 0 auto;
}

.score-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 5rpx solid transparent;
  background:
    linear-gradient(#fff, #fff) padding-box,
    linear-gradient(135deg, #8b6cff 0%, #6eb8a0 100%) border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.score-num {
  color: #2f2936;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.score-unit-sm {
  color: #8c8498;
  font-size: 20rpx;
  line-height: 1.2;
}

.grade-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8b6cff 0%, #6eb8a0 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-divider {
  width: 1rpx;
  height: 80rpx;
  background: #e9e1d8;
  margin: 0 28rpx;
  flex: 0 0 auto;
}

.hero-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hero-stat-item {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4rpx;
}

.hsi-val {
  color: #2f2936;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
}

.hsi-unit {
  color: #8c8498;
  font-size: 22rpx;
}

.hsi-label {
  display: block;
  width: 100%;
  color: #807987;
  font-size: 22rpx;
  margin-top: 2rpx;
}

.hero-stat-sep {
  height: 1rpx;
  background: #f0ecf4;
  margin: 10rpx 0;
}

/* ── Trend Card ── */
.trend-card {
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 20rpx;
}

.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 700;
}

.card-meta {
  color: #8c8498;
  font-size: 22rpx;
}

.bars-wrap {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 200rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  height: 100%;
}

.bar-outer {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
}

.bar-inner {
  width: 100%;
  min-height: 16rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #c4b5fd 0%, #e9e1f8 100%);
  transition: height 0.3s;
}

.bar-today {
  background: linear-gradient(180deg, #8b6cff 0%, #b39dff 100%);
  box-shadow: 0 4rpx 12rpx rgba(139, 108, 255, 0.30);
}

.bar-empty {
  background: #f0ecf4;
  opacity: 0.5;
}

.bar-label {
  color: #8c8498;
  font-size: 20rpx;
  flex: 0 0 auto;
}

.label-today {
  color: #8b6cff;
  font-weight: 700;
}

/* ── Macro Card ── */
.section-hd-row {
  margin: 24rpx 0 14rpx;
}

.macro-card {
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
}

.macro-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.macro-border {
  border-top: 1rpx solid #f0ecf4;
}

.macro-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 120rpx;
}

.macro-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex: 0 0 auto;
}

.dot-purple { background: #8b6cff; }
.dot-amber  { background: #f59e0b; }
.dot-green  { background: #5fa86e; }
.dot-teal   { background: #38b2ac; }

.macro-name {
  color: #2f2936;
  font-size: 24rpx;
  font-weight: 500;
}

.macro-mid {
  flex: 1;
}

.macro-bar-bg {
  height: 10rpx;
  border-radius: 999rpx;
  background: #f0ecf4;
  overflow: hidden;
}

.macro-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.4s;
}

.fill-purple { background: linear-gradient(90deg, #8b6cff, #b39dff); }
.fill-amber  { background: linear-gradient(90deg, #f59e0b, #fcd34d); }
.fill-green  { background: linear-gradient(90deg, #5fa86e, #86efac); }
.fill-teal   { background: linear-gradient(90deg, #38b2ac, #5eead4); }

.macro-right {
  flex: 0 0 auto;
  display: flex;
  align-items: baseline;
  gap: 0;
}

.macro-val {
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 600;
}

.macro-cap {
  color: #b0aab8;
  font-size: 20rpx;
}

/* ── Stats Grid ── */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24rpx 22rpx;
  gap: 8rpx;
}

.stat-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.stat-val {
  color: #2f2936;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 8rpx;
}

.stat-lbl {
  color: #8c8498;
  font-size: 22rpx;
}

/* ── Insight Card ── */
.insight-card {
  padding: 24rpx 26rpx;
  margin-bottom: 8rpx;
}

.insight-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.insight-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #6eb87a;
  flex: 0 0 auto;
}

.insight-title {
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 700;
}

.insight-body {
  color: #5f576a;
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-line;
}
