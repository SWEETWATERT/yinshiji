.score-card,
.trend-card,
.protein-card,
.advice-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.score-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.score-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 12rpx;
}

.score {
  color: #8d7cf0;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.score-unit {
  color: #8c8498;
  font-size: 26rpx;
}

.score-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  color: #8d7cf0;
  font-size: 34rpx;
  line-height: 1;
  background: #f1effc;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.head-meta {
  color: #8c8498;
  font-size: 24rpx;
}

.bars {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  height: 210rpx;
  padding-top: 12rpx;
}

.bar {
  flex: 1;
  min-height: 28rpx;
  border-radius: 999rpx 999rpx 12rpx 12rpx;
  background: linear-gradient(180deg, #8d7cf0 0%, #f6cadc 100%);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.stat-card {
  padding: 24rpx;
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1;
  background: #f3f1f5;
}

.stat-value {
  margin-top: 14rpx;
  color: #2f2936;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  color: #8c8498;
  font-size: 24rpx;
}

.advice {
  margin-top: 12rpx;
  color: #5f576a;
  font-size: 26rpx;
  line-height: 1.6;
}
