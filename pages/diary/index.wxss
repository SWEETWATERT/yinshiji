.diary-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ── Header ── */
.diary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.report-btn {
  flex: 0 0 auto;
  width: 132rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  border: 2rpx solid #26302A;
  background: #FFFFFF;
  color: #26302A;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  padding: 0;
}

/* ── Streak Card ── */
.streak-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.streak-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.streak-desc {
  color: #807987;
  font-size: 24rpx;
}

.streak-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.streak-num {
  color: #8B6CFF;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.streak-unit {
  color: #807987;
  font-size: 26rpx;
}

.streak-btn {
  padding: 14rpx 26rpx;
  border-radius: 12rpx;
  background: #EEE8FF;
  color: #8B6CFF;
  font-size: 26rpx;
  font-weight: 600;
  border: 1.5rpx solid rgba(139, 108, 255, 0.22);
}

/* ── Date Strip ── */
.date-strip {
  width: 100%;
  margin-bottom: 28rpx;
  white-space: nowrap;
}

.date-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 8rpx;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 96rpx;
  border-radius: 16rpx;
  color: #807987;
  background: #FFFFFF;
  border: 1.5rpx solid #E9E1D8;
  flex-shrink: 0;
  gap: 4rpx;
}

.date-active {
  color: #fff;
  background: #8B6CFF;
  border-color: #8B6CFF;
  box-shadow: 0 4rpx 14rpx rgba(139, 108, 255, 0.28);
}

.date-day {
  font-size: 30rpx;
  font-weight: 700;
}

.date-week {
  font-size: 22rpx;
}

/* ── Module Title ── */
.module-title {
  color: #25232A;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

/* ── Photo Wall ── */
.photo-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.photo-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.photo-empty {
  opacity: 0.65;
}

.photo-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 156rpx;
}

.ph-tone-pink   { background: #FFE9F3; }
.ph-tone-mint   { background: #EAF3E4; }
.ph-tone-purple { background: #EEE8FF; }
.ph-tone-gold   { background: #FFF4DF; }

.photo-meal-icon {
  font-size: 64rpx;
  line-height: 1;
}

.photo-real-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #F7F2EA;
}

.photo-check {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #7FA66A;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 36rpx;
}

.photo-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-top: 1rpx solid #E9E1D8;
}

.photo-name {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 700;
}

.photo-kcal {
  color: #807987;
  font-size: 24rpx;
  font-weight: 600;
}

.dim { color: #C4B8D0; }

/* ── Mood Card ── */
.mood-card {
  padding: 0;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.mood-section {
  padding: 22rpx 26rpx;
}

.mood-title {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 14rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mood-divider {
  height: 1rpx;
  background: #E9E1D8;
}

/* ── AI Summary Card ── */
.summary-card {
  padding: 24rpx 26rpx;
  margin-bottom: 4rpx;
}

.summary-hd {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.summary-dot {
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #7FA66A;
  flex-shrink: 0;
}

.summary-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
}

.summary-body {
  color: #25232A;
  font-size: 28rpx;
  line-height: 1.7;
  display: block;
}

.summary-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.summary-empty {
  border-color: rgba(139, 108, 255, 0.18);
}

.summary-empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #8B6CFF;
  font-size: 25rpx;
  font-weight: 700;
  background: #EEE8FF;
}

.stag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.stag-good {
  color: #7FA66A;
  background: #EAF3E4;
}

.stag-warn {
  color: #E4A543;
  background: #FFF4DF;
}

/* ── Meal Details ── */
.detail-state {
  padding: 28rpx 30rpx;
  margin-bottom: 22rpx;
}

.detail-state-title {
  display: block;
  color: #25232A;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-state-text {
  display: block;
  margin-top: 8rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.55;
}

.detail-error {
  border: 1rpx solid #ffd6df;
  background: #fff7f9;
}

.meal-detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.meal-detail-card {
  padding: 24rpx 26rpx;
}

.meal-detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.meal-detail-title {
  display: block;
  color: #25232A;
  font-size: 30rpx;
  font-weight: 800;
}

.meal-detail-time {
  display: block;
  margin-top: 4rpx;
  color: #807987;
  font-size: 23rpx;
}

.meal-detail-kcal {
  flex: 0 0 auto;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #8B6CFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.meal-macro-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #5f576a;
  font-size: 24rpx;
}

.meal-macro-row text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #F7F2EA;
}

.meal-source-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.meal-source,
.meal-review {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #EEE8FF;
  color: #8B6CFF;
}

.meal-review {
  background: #FFF4DF;
  color: #B87A00;
}

.food-chip-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.food-detail-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #FAF7F8;
}

.food-detail-name {
  color: #25232A;
  font-size: 25rpx;
  font-weight: 700;
}

.food-detail-meta {
  color: #807987;
  font-size: 23rpx;
}

.meal-no-foods {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  color: #807987;
  background: #FAF7F8;
  font-size: 24rpx;
}
