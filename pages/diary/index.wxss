.diary-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.report-entry {
  flex: 0 0 104rpx;
  height: 56rpx;
  border-radius: 18rpx;
  color: #7b66d9;
  font-size: 24rpx;
  background: #fff;
}

.streak-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
}

.streak-line {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 6rpx;
}

.streak {
  color: #8d7cf0;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.streak-unit,
.streak-copy {
  color: #8c8498;
  font-size: 24rpx;
}

.date-strip {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.date-inner {
  display: flex;
  gap: 14rpx;
  width: max-content;
  padding-right: 32rpx;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 88rpx;
  border-radius: 22rpx;
  color: #8c8498;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(31, 25, 36, 0.04);
}

.date-item.active {
  color: #fff;
  background: linear-gradient(135deg, #f58bb8 0%, #8d7cf0 100%);
}

.date-day {
  font-size: 28rpx;
  font-weight: 600;
}

.date-week {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.mood-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.state-title {
  margin-top: 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
}

.diary-page .chip {
  flex: 0 0 auto;
}

.section-block {
  margin-top: 28rpx;
}

.meal-status-list,
.meal-list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.meal-status-row {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
}

.meal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  font-size: 32rpx;
  background: #f3f1f5;
}

.meal-info {
  min-width: 0;
}

.meal-name,
.meal-title {
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 600;
}

.meal-sub,
.meal-time,
.food-names {
  margin-top: 4rpx;
  color: #8c8498;
  font-size: 24rpx;
}

.status-chip {
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #8c8498;
  font-size: 22rpx;
  line-height: 44rpx;
  background: #f3f1f5;
}

.status-chip.done {
  color: #2f8b68;
  background: #e9f8f1;
}

.meal-row {
  padding: 24rpx;
}

.meal-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.meal-kcal {
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.food-wall {
  margin-top: 16rpx;
  white-space: nowrap;
}

.food-inner {
  width: max-content;
}

.food-tile {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1;
  background: #f3f1f5;
}

.food-name-item {
  margin-right: 16rpx;
}

.empty {
  padding: 36rpx;
  color: #8c8498;
  text-align: center;
  font-size: 26rpx;
}
