<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.10;"></image>
</view>
<view class="page page-container diary-page">

  <!-- Brand Header -->
  <brand-header></brand-header>

  <!-- Header -->
  <view class="diary-header">
    <view>
      <view class="page-title">饮食日记</view>
      <view class="page-subtitle">看看今天吃了什么，也可以补记漏掉的一餐</view>
    </view>
    <button class="report-btn" bindtap="goReport">周报</button>
  </view>

  <!-- Streak Card -->
  <view class="streak-card section-card">
    <view class="streak-left">
      <text class="streak-desc">连续记录</text>
      <view class="streak-num-row">
        <text class="streak-num">23</text>
        <text class="streak-unit">天</text>
      </view>
    </view>
    <view class="streak-right">
      <view class="streak-btn">继续打卡</view>
    </view>
  </view>

  <!-- Date Strip -->
  <scroll-view class="date-strip" scroll-x>
    <view class="date-inner">
      <block wx:for="{{dates}}" wx:key="date">
        <view
          class="date-item {{selectedDate === item.date ? 'date-active' : ''}}"
          data-date="{{item.date}}"
          bindtap="selectDate"
        >
          <text class="date-day">{{item.day}}</text>
          <text class="date-week">{{item.week}}</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- Meal Photo Wall -->
  <view class="module-title">今日餐食状态</view>
  <view class="photo-wall">
    <block wx:for="{{mealCards}}" wx:key="type">
      <view class="photo-card section-card {{item.recorded ? '' : 'photo-empty'}}" bindtap="goRecord">
        <view class="photo-top ph-tone-{{item.tone}}">
          <image wx:if="{{item.imageUrl}}" class="photo-real-img" src="{{item.imageUrl}}" mode="aspectFit"></image>
          <text wx:else class="photo-meal-icon">{{item.icon}}</text>
          <view wx:if="{{item.recorded}}" class="photo-check">✓</view>
        </view>
        <view class="photo-meta">
          <text class="photo-name">{{item.name}}</text>
          <text class="photo-kcal {{item.recorded ? '' : 'dim'}}">
            {{item.recorded ? item.kcal + ' kcal' : '去补记'}}
          </text>
        </view>
      </view>
    </block>
  </view>

  <!-- Mood & State -->
  <view class="mood-card section-card">
    <view class="mood-section">
      <text class="mood-title">心情记录</text>
      <view class="chip-row">
        <block wx:for="{{moods}}" wx:key="*this">
          <view
            class="chip {{selectedMood === item ? 'chip-active' : ''}}"
            data-value="{{item}}"
            bindtap="selectMood"
          >{{item}}</view>
        </block>
      </view>
    </view>
    <view class="mood-divider"></view>
    <view class="mood-section">
      <text class="mood-title">餐后状态</text>
      <view class="chip-row">
        <block wx:for="{{states}}" wx:key="*this">
          <view class="chip">{{item}}</view>
        </block>
      </view>
    </view>
  </view>


  <!-- Meal Details -->
  <view class="module-title">餐食明细</view>
  <view wx:if="{{loading}}" class="detail-state section-card">
    <text class="detail-state-title">正在读取日记…</text>
    <text class="detail-state-text">稍等一下，正在整理这一天的餐食。</text>
  </view>
  <view wx:elif="{{errorMessage}}" class="detail-state section-card detail-error">
    <text class="detail-state-title">读取失败</text>
    <text class="detail-state-text">{{errorMessage}}</text>
  </view>
  <view wx:elif="{{displayMeals.length === 0}}" class="detail-state section-card" bindtap="goRecord">
    <text class="detail-state-title">暂无餐食明细</text>
    <text class="detail-state-text">记录一餐后，这里会显示食物、克数和营养估算。</text>
  </view>
  <view wx:else class="meal-detail-list">
    <block wx:for="{{displayMeals}}" wx:key="id">
      <view class="meal-detail-card section-card">
        <view class="meal-detail-head">
          <view>
            <text class="meal-detail-title">{{item.mealName}}</text>
            <text class="meal-detail-time">{{item.time || '未记录时间'}}</text>
          </view>
          <view class="meal-detail-kcal">{{item.nutrition.kcal}} kcal</view>
        </view>
        <view class="meal-macro-row">
          <text>蛋白 {{item.nutrition.protein}}g</text>
          <text>碳水 {{item.nutrition.carbs}}g</text>
          <text>脂肪 {{item.nutrition.fat}}g</text>
        </view>
        <view class="meal-source-row">
          <text class="meal-source">{{item.recognitionText}}</text>
          <text wx:if="{{item.confidencePercent}}" class="meal-source">置信度 {{item.confidencePercent}}%</text>
          <text wx:if="{{item.needReview}}" class="meal-review">需复核</text>
        </view>
        <view wx:if="{{item.hasFoods}}" class="food-chip-list">
          <block wx:for="{{item.foods}}" wx:for-item="food" wx:key="id">
            <view class="food-detail-chip">
              <text class="food-detail-name">{{food.name}}</text>
              <text class="food-detail-meta">{{food.weight}}g · {{food.kcal}}kcal</text>
            </view>
          </block>
        </view>
        <view wx:else class="meal-no-foods">这条记录暂无食物明细，仅保留总营养。</view>
      </view>
    </block>
  </view>

  <!-- AI Summary -->
  <view wx:if="{{meals.length > 0}}" class="summary-card section-card">
    <view class="summary-hd">
      <view class="summary-dot"></view>
      <text class="summary-title">今日总结</text>
    </view>
    <text class="summary-body">
      今天蛋白质摄入不错，蔬菜略少。晚餐可以补一份深色蔬菜，让今天的餐盘更完整。
    </text>
    <view class="summary-tags">
      <text class="stag stag-good">蛋白质达标</text>
      <text class="stag stag-warn">蔬菜偏少</text>
    </view>
  </view>
  <view wx:else class="summary-card section-card summary-empty" bindtap="goRecord">
    <view class="summary-hd">
      <view class="summary-dot"></view>
      <text class="summary-title">还没有餐食记录</text>
    </view>
    <text class="summary-body">先记录一餐，日记会自动整理照片、热量和当天状态。</text>
    <view class="summary-empty-action">去记录第一餐</view>
  </view>

</view>
