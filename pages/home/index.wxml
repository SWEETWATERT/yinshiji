<view class="page page-container home-page">
  <view class="page-header">
    <view>
      <view class="page-title">今日饮食</view>
      <view class="page-subtitle">{{todayText}} · {{user.nickname}}已登录</view>
    </view>
    <button class="report-entry" bindtap="goReport">周报</button>
  </view>

  <view class="intake-card section-card">
    <view class="card-head">
      <text class="section-title">今日摄入</text>
      <text class="head-meta">{{caloriePercent}}%</text>
    </view>
    <view class="calorie-main">
      <text class="calorie-now">{{totals.kcal}}</text>
      <text class="calorie-target"> / {{target}} kcal</text>
    </view>
    <view class="progress-bar"><view class="progress-inner" style="width: {{caloriePercent}}%;"></view></view>
    <view class="remain-copy">还可摄入 {{remainingCalories}} kcal</view>
  </view>

  <button class="primary-button record-button" bindtap="goRecord">📷 拍照记录这一餐</button>

  <view class="nutrition-card section-card">
    <view class="card-head">
      <text class="section-title">营养进度</text>
      <text class="head-meta">今日</text>
    </view>
    <view class="nutrition-row">
      <text class="macro-name">蛋白质</text>
      <text class="macro-value">{{totals.protein}}g</text>
      <view class="progress-bar"><view class="progress-inner protein" style="width: {{proteinPercent}}%;"></view></view>
    </view>
    <view class="nutrition-row">
      <text class="macro-name">碳水</text>
      <text class="macro-value">{{totals.carbs}}g</text>
      <view class="progress-bar"><view class="progress-inner carbs" style="width: {{carbsPercent}}%;"></view></view>
    </view>
    <view class="nutrition-row">
      <text class="macro-name">脂肪</text>
      <text class="macro-value">{{totals.fat}}g</text>
      <view class="progress-bar"><view class="progress-inner fat" style="width: {{fatPercent}}%;"></view></view>
    </view>
  </view>

  <view class="section-block">
    <view class="section-title">今日餐次</view>
    <view class="meal-grid">
      <block wx:for="{{mealCards}}" wx:key="type">
        <view class="meal-card section-card">
          <view class="meal-icon {{item.tone}}">{{item.image}}</view>
          <view class="meal-info">
            <view class="meal-name">{{item.name}}</view>
            <view class="meal-kcal">{{item.kcal}} kcal</view>
          </view>
          <view class="meal-status {{item.recorded ? 'done' : ''}}">{{item.recorded ? '已记录' : '未记录'}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="score-card section-card">
    <view class="card-head">
      <text class="section-title">健康评分</text>
      <text class="head-meta">{{hasMeals ? '已生成' : '待生成'}}</text>
    </view>
    <block wx:if="{{hasMeals}}">
      <view class="score-line">
        <text class="score">{{healthScore}}</text>
        <text class="score-unit">分</text>
      </view>
      <view class="score-copy">根据今日已记录餐食估算</view>
    </block>
    <view wx:else class="empty-score">暂无评分，记录一餐后生成</view>
  </view>
</view>
