<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.10;"></image>
</view>
<view class="page page-container home-page">

  <!-- Brand Header -->
  <brand-header></brand-header>

  <!-- Header -->
  <view class="home-header">
    <view>
      <view class="page-title">今日饮食</view>
      <view class="page-subtitle">{{todayText}} · {{user.nickname || '小禾'}}已登录</view>
    </view>
    <button class="report-btn" bindtap="goReport">周报</button>
  </view>

  <!-- Health Score Hero -->
  <view class="hero-card">
    <view class="hero-inner">
      <text class="hero-label">今日健康分</text>
      <view class="hero-score-row">
        <text class="hero-score">{{healthScore}}</text>
        <text class="hero-unit">分</text>
      </view>
      <text class="hero-praise">太棒了，继续保持</text>
      <view class="hero-divider"></view>
      <view class="hero-stat-row">
        <text class="hero-stat-label">热量控制</text>
        <text class="hero-stat-val">{{caloriePercent}}%</text>
        <text class="hero-stat-label">· 比昨天高 8 分</text>
      </view>
    </view>
  </view>

  <!-- Today Intake -->
  <view class="intake-card section-card">
    <view class="intake-head">
      <text class="section-title">今日摄入</text>
      <text class="intake-tag">{{caloriePercent}}%</text>
    </view>
    <view class="calorie-row">
      <text class="calorie-big">{{totals.kcal}}</text>
      <text class="calorie-sep"> / {{target}} kcal</text>
    </view>
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{caloriePercent}}%;"></view>
    </view>
    <text class="remain-txt">还可摄入 {{remainingCalories}} kcal</text>
  </view>

  <!-- Nutrition Grid 2x2 -->
  <view class="module-title">营养结构</view>
  <view class="nutri-grid">

    <view class="nutri-card section-card">
      <view class="nutri-hd">
        <view class="ndot ndot-purple"></view>
        <text class="nutri-name">蛋白质</text>
      </view>
      <view class="nutri-num-row">
        <text class="nutri-big">{{totals.protein}}</text>
        <text class="nutri-g">g</text>
      </view>
      <text class="nutri-goal">目标 90g</text>
      <view class="nutri-bar">
        <view class="nbar-fill nbar-purple" style="width: {{proteinPercent}}%;"></view>
      </view>
    </view>

    <view class="nutri-card section-card">
      <view class="nutri-hd">
        <view class="ndot ndot-amber"></view>
        <text class="nutri-name">碳水</text>
      </view>
      <view class="nutri-num-row">
        <text class="nutri-big">{{totals.carbs}}</text>
        <text class="nutri-g">g</text>
      </view>
      <text class="nutri-goal">目标 250g</text>
      <view class="nutri-bar">
        <view class="nbar-fill nbar-amber" style="width: {{carbsPercent}}%;"></view>
      </view>
    </view>

    <view class="nutri-card section-card">
      <view class="nutri-hd">
        <view class="ndot ndot-green"></view>
        <text class="nutri-name">脂肪</text>
      </view>
      <view class="nutri-num-row">
        <text class="nutri-big">{{totals.fat}}</text>
        <text class="nutri-g">g</text>
      </view>
      <text class="nutri-goal">目标 65g</text>
      <view class="nutri-bar">
        <view class="nbar-fill nbar-green" style="width: {{fatPercent}}%;"></view>
      </view>
    </view>

    <view class="nutri-card section-card">
      <view class="nutri-hd">
        <view class="ndot ndot-teal"></view>
        <text class="nutri-name">纤维</text>
      </view>
      <view class="nutri-num-row">
        <text class="nutri-big">18</text>
        <text class="nutri-g">g</text>
      </view>
      <text class="nutri-goal">目标 25g</text>
      <view class="nutri-bar">
        <view class="nbar-fill nbar-teal" style="width: 72%;"></view>
      </view>
    </view>

  </view>

  <!-- Record Entry -->
  <view class="record-entry section-card" bindtap="goRecord">
    <view class="rec-icon-box">
      <text class="rec-icon-char">拍</text>
    </view>
    <view class="rec-text">
      <view class="rec-title">拍照记录这一餐</view>
      <view class="rec-sub">AI 估算热量和营养</view>
    </view>
    <text class="rec-arrow">›</text>
  </view>

  <!-- Today Meals -->
  <view class="module-title">今日餐次</view>
  <view class="meal-grid">
    <block wx:for="{{mealCards}}" wx:key="type">
      <view class="meal-card section-card">
        <view class="meal-accent tone-{{item.tone}}"></view>
        <view class="meal-body">
          <text class="meal-emoji-lg">{{item.image}}</text>
          <view class="meal-name-lg">{{item.name}}</view>
          <view class="meal-kcal-row">
            <text class="meal-kcal-big {{item.recorded ? '' : 'kcal-dim'}}">
              {{item.recorded ? item.kcal : '—'}}
            </text>
            <text wx:if="{{item.recorded}}" class="meal-kcal-u"> kcal</text>
          </view>
          <view class="meal-status-tag {{item.recorded ? 'tag-done' : 'tag-todo'}}">
            {{item.recorded ? '已记录' : '待记录'}}
          </view>
        </view>
      </view>
    </block>
  </view>

</view>
