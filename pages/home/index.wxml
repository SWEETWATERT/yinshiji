<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.10;"></image>
</view>
<view class="page page-container home-page ai-home-page">

  <brand-header></brand-header>

  <view class="home-header ai-home-header">
    <view>
      <view class="page-title">AI今日分析中心</view>
      <view class="page-subtitle">{{todayText}} · AI正在分析你的饮食状态</view>
    </view>
    <button class="report-btn" bindtap="goReport">周报</button>
  </view>

  <view class="ai-center-card section-card {{!hasMeals ? 'ai-center-empty' : ''}}">
    <view class="ai-center-head">
      <view>
        <view class="ai-center-kicker">AI结论优先</view>
        <view class="ai-center-title">今日饮食判断</view>
      </view>
      <view class="ai-center-grade">{{aiCenter.grade}}</view>
    </view>

    <view class="ai-score-hero">
      <text class="ai-score-main-num">{{aiCenter.score}}</text>
      <text class="ai-score-main-unit">分</text>
    </view>
    <view class="ai-center-evaluation">{{aiCenter.evaluation}}</view>

    <view class="ai-center-section">
      <view class="ai-center-section-title">今日营养问题</view>
      <view class="ai-center-issue-list">
        <block wx:for="{{aiCenter.issues}}" wx:key="*this">
          <view class="ai-center-issue">{{item}}</view>
        </block>
      </view>
    </view>

    <view class="ai-center-section">
      <view class="ai-center-section-title">AI建议</view>
      <block wx:for="{{aiCenter.advice}}" wx:key="*this">
        <view class="ai-center-advice">{{item}}</view>
      </block>
      <view wx:if="{{aiCenter.advice.length === 0}}" class="ai-center-advice">先记录一餐，AI会给出下一餐建议。</view>
    </view>

    <view class="ai-center-nutrition">
      <view class="ai-center-nutrition-item">
        <text class="ai-center-nutrition-label">kcal</text>
        <text class="ai-center-nutrition-value">{{aiCenter.kcal}}</text>
      </view>
      <view class="ai-center-nutrition-item">
        <text class="ai-center-nutrition-label">蛋白</text>
        <text class="ai-center-nutrition-value">{{aiCenter.protein}}g</text>
      </view>
      <view class="ai-center-nutrition-item">
        <text class="ai-center-nutrition-label">碳水</text>
        <text class="ai-center-nutrition-value">{{aiCenter.carbs}}g</text>
      </view>
      <view class="ai-center-nutrition-item">
        <text class="ai-center-nutrition-label">脂肪</text>
        <text class="ai-center-nutrition-value">{{aiCenter.fat}}g</text>
      </view>
    </view>

    <view class="ai-center-footer">
      <view class="ai-center-streak">{{streak.todayCheckedIn ? '今日已打卡' : '今日待打卡'}} · 连续 {{streak.consecutiveDays}} 天</view>
      <button class="ai-center-action" bindtap="goAnalyze">开始AI饮食分析</button>
    </view>

    <view wx:if="{{weightProgress.visible}}" class="weight-progress-mini" bindtap="goProgress">
      <view>
        <view class="weight-progress-label">减脂进度</view>
        <view class="weight-progress-text">{{weightProgress.text}}</view>
      </view>
      <view class="weight-progress-link">记录体重</view>
    </view>
  </view>

</view>
