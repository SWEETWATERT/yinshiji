<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.10;"></image>
</view>
<view class="page page-container home-page ai-home-page">

  <brand-header></brand-header>

  <view class="home-header ai-home-header">
    <view>
      <view class="page-title">今日健康</view>
      <view class="page-subtitle">{{todayText}} · 每天打开，看清今天怎么吃</view>
    </view>
    <button class="report-btn" bindtap="goReport">周报</button>
  </view>

  <view class="daily-hero section-card">
    <view class="daily-metric-row">
      <view class="daily-metric">
        <text class="daily-metric-label">今日体重</text>
        <text class="daily-metric-value">{{weightProgress.currentWeightText}}kg</text>
      </view>
      <view class="daily-metric">
        <text class="daily-metric-label">距目标</text>
        <text class="daily-metric-value">{{weightProgress.remainingKgText}}kg</text>
      </view>
      <view class="daily-metric">
        <text class="daily-metric-label">连续打卡</text>
        <text class="daily-metric-value">{{fatLossCoach.consecutiveDays}}天</text>
      </view>
    </view>

    <view class="daily-hero-main">
      <view class="daily-score-ring" style="background: conic-gradient(#58A27F 0 {{aiCenter.score}}%, #E5EFE9 {{aiCenter.score}}% 100%);">
        <view class="daily-score-inner">
          <text class="daily-score-num">{{aiCenter.score}}</text>
          <text class="daily-score-unit">分</text>
        </view>
      </view>
      <view class="daily-hero-copy">
        <view class="daily-hero-kicker">AI今日饮食助手</view>
        <view class="daily-hero-title">{{fatLossCoach.fatLossStatus.label}}</view>
        <view class="daily-hero-desc">{{fatLossCoach.fatLossStatus.text}}</view>
      </view>
    </view>

    <view class="daily-target-grid">
      <view class="daily-target">
        <view class="daily-target-head">
          <text>热量</text>
          <text>{{fatLossCoach.calorieStatus.percent}}%</text>
        </view>
        <view class="daily-target-value">{{fatLossCoach.calorieStatus.text}}</view>
        <view class="daily-target-track">
          <view class="daily-target-fill" style="width: {{fatLossCoach.calorieStatus.percent}}%;"></view>
        </view>
      </view>
      <view class="daily-target">
        <view class="daily-target-head">
          <text>蛋白</text>
          <text>{{fatLossCoach.proteinStatus.percent}}%</text>
        </view>
        <view class="daily-target-value">{{fatLossCoach.proteinStatus.text}}</view>
        <view class="daily-target-track">
          <view class="daily-target-fill protein-fill" style="width: {{fatLossCoach.proteinStatus.percent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="daily-ai-card section-card status-{{fatLossCoach.fatLossStatus.level}}">
    <view class="fat-loss-advice">
      <view class="fat-loss-section-label">AI建议</view>
      <view class="fat-loss-advice-text">{{fatLossCoach.advice}}</view>
      <view class="fat-loss-next">{{fatLossCoach.nextMealSuggestion}}</view>
    </view>

    <view class="daily-action-row">
      <button class="daily-primary-action" bindtap="goAnalyze">开始AI饮食分析</button>
      <button class="daily-secondary-action" bindtap="goProgress">记录体重</button>
    </view>

    <view class="weekly-insight">
      <view class="fat-loss-section-label">AI周总结</view>
      <view class="weekly-summary">{{weeklyInsight.summary}}</view>
      <view class="weekly-grid">
        <view class="weekly-item">
          <text class="weekly-label">平均热量</text>
          <text class="weekly-value">{{weeklyInsight.averageCalories}} kcal</text>
        </view>
        <view class="weekly-item">
          <text class="weekly-label">平均蛋白</text>
          <text class="weekly-value">{{weeklyInsight.averageProtein}} g</text>
        </view>
        <view class="weekly-item">
          <text class="weekly-label">完成率</text>
          <text class="weekly-value">{{weeklyInsight.completionRate}}%</text>
        </view>
      </view>
    </view>
  </view>

</view>
