.home-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.report-entry {
  flex: 0 0 104rpx;
  height: 56rpx;
  border-radius: 18rpx;
  color: #7b66d9;
  font-size: 24rpx;
  font-weight: 500;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(31, 25, 36, 0.04);
}

.intake-card,
.nutrition-card,
.score-card {
  padding: 28rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.head-meta {
  color: #8c8498;
  font-size: 24rpx;
  font-weight: 400;
  white-space: nowrap;
}

.calorie-main {
  display: flex;
  align-items: baseline;
  margin: 22rpx 0 18rpx;
  white-space: nowrap;
}

.calorie-now {
  color: #2f2936;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.calorie-target {
  color: #8c8498;
  font-size: 28rpx;
  font-weight: 400;
}

.remain-copy {
  margin-top: 16rpx;
  color: #8c8498;
  font-size: 24rpx;
}

.record-button {
  margin: 24rpx 0;
}

.nutrition-row {
  display: grid;
  grid-template-columns: 96rpx 80rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.macro-name {
  color: #5f576a;
}

.macro-value {
  color: #2f2936;
  font-weight: 500;
  text-align: right;
  white-space: nowrap;
}

.progress-inner.protein {
  background: linear-gradient(90deg, #62c9a7, #8d7cf0);
}

.progress-inner.carbs {
  background: linear-gradient(90deg, #f3c46a, #f58bb8);
}

.progress-inner.fat {
  background: linear-gradient(90deg, #8ab7f5, #8d7cf0);
}

.section-block {
  margin-top: 28rpx;
}

.meal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 18rpx;
}

.meal-card {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  align-items: start;
  column-gap: 14rpx;
  row-gap: 10rpx;
  min-height: 158rpx;
  padding: 20rpx;
  text-align: left;
}

.meal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  font-size: 34rpx;
  line-height: 1;
  background: #f7f1f5;
}

.meal-icon.pink {
  background: #fff0f5;
}

.meal-icon.mint {
  background: #edf8f3;
}

.meal-icon.purple {
  background: #f1effc;
}

.meal-icon.gold {
  background: #fff7e8;
}

.meal-info {
  min-width: 0;
}

.meal-name {
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
}

.meal-kcal {
  margin-top: 4rpx;
  color: #8c8498;
  font-size: 24rpx;
  white-space: nowrap;
}

.meal-status {
  grid-column: 1 / 3;
  justify-self: start;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #8c8498;
  font-size: 22rpx;
  line-height: 44rpx;
  background: #f3f1f5;
}

.meal-status.done {
  color: #2f8b68;
  background: #e9f8f1;
}

.score-card {
  margin-top: 28rpx;
}

.score-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 18rpx;
  white-space: nowrap;
}

.score {
  color: #8d7cf0;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.score-unit {
  color: #8c8498;
  font-size: 26rpx;
}

.score-copy,
.empty-score {
  margin-top: 10rpx;
  color: #8c8498;
  font-size: 24rpx;
  line-height: 1.45;
}
