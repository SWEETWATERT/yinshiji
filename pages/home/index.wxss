.home-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ── Header ── */
.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.report-btn {
  flex: 0 0 auto;
  width: 132rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  border: 2rpx solid #26302A;
  background: #FFFFFF;
  color: #26302A;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

/* ── Hero Score Card ── */
.hero-card {
  width: 100%;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FF83B7 0%, #8B6CFF 100%);
  box-shadow: 0 12rpx 32rpx rgba(139, 108, 255, 0.22);
  margin-top: 24rpx;
  margin-bottom: 4rpx;
}

.hero-card-empty {
  background: #FFFFFF;
  border: 1rpx solid #E9E1D8;
  box-shadow: 0 2rpx 12rpx rgba(37, 35, 42, 0.05);
}

.hero-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-label {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.hero-score-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin: 10rpx 0;
}

.hero-score {
  color: #fff;
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-unit {
  color: rgba(255, 255, 255, 0.90);
  font-size: 34rpx;
  font-weight: 700;
}

.hero-praise {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  font-weight: 400;
}

.hero-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.25);
  margin: 20rpx 0;
}

.hero-stat-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.hero-stat-label {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
}

.hero-stat-val {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-card-empty .hero-label,
.hero-card-empty .hero-praise {
  color: #807987;
}

.hero-empty-title {
  margin: 14rpx 0 10rpx;
  color: #25232A;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

/* ── Intake Card ── */
.intake-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.weight-progress-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  border-color: #DFEEE5;
  background: #FBFDFC;
}

.weight-progress-label {
  color: #256850;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.weight-progress-text {
  margin-top: 6rpx;
  color: #25232A;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.weight-progress-link {
  flex: 0 0 auto;
  color: #8B6CFF;
  font-size: 23rpx;
  font-weight: 900;
}

/* ── First Use Guide ── */
.guide-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  border-color: rgba(139, 108, 255, 0.18);
  background: #FFFCFE;
}

.guide-mark {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF83B7 0%, #8B6CFF 100%);
}

.guide-copy {
  flex: 1;
  min-width: 0;
}

.guide-title {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.guide-desc {
  margin-top: 6rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.5;
}

.guide-action {
  flex: 0 0 auto;
  color: #8B6CFF;
  font-size: 25rpx;
  font-weight: 700;
}

.intake-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.intake-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #EEE8FF;
  color: #8B6CFF;
  font-size: 24rpx;
  font-weight: 700;
}

.calorie-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.calorie-big {
  color: #25232A;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.calorie-sep {
  color: #807987;
  font-size: 28rpx;
  font-weight: 400;
}

.remain-txt {
  display: block;
  margin-top: 14rpx;
  color: #807987;
  font-size: 26rpx;
}

/* ── Module Title ── */
.module-title {
  color: #25232A;
  font-size: 34rpx;
  font-weight: 700;
  margin: 4rpx 0 18rpx;
}

/* ── Nutrition Grid 2×2 ── */
.nutri-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.nutri-card {
  padding: 24rpx 22rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nutri-hd {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ndot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.ndot-purple { background: #8B6CFF; }
.ndot-amber  { background: #E4A543; }
.ndot-green  { background: #7FA66A; }
.ndot-teal   { background: #5BBFBD; }

.nutri-name {
  color: #807987;
  font-size: 25rpx;
  font-weight: 500;
}

.nutri-num-row {
  display: flex;
  align-items: baseline;
  gap: 3rpx;
}

.nutri-big {
  color: #25232A;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.nutri-g {
  color: #807987;
  font-size: 22rpx;
  font-weight: 500;
}

.nutri-goal {
  color: #807987;
  font-size: 22rpx;
}

.nutri-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: #E9E1D8;
  overflow: hidden;
}

.nbar-fill {
  height: 100%;
  border-radius: 999rpx;
}
.nbar-purple { background: #8B6CFF; }
.nbar-amber  { background: #E4A543; }
.nbar-green  { background: #7FA66A; }
.nbar-teal   { background: #5BBFBD; }

/* ── Record Entry ── */
.record-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 28rpx;
}

.rec-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FF83B7 0%, #8B6CFF 100%);
}

.rec-icon-char {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.rec-text { flex: 1; min-width: 0; }

.rec-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.rec-sub {
  margin-top: 6rpx;
  color: #807987;
  font-size: 25rpx;
}

.rec-arrow {
  color: #C4B8D0;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 300;
}

/* ── Meal Grid ── */
.meal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.meal-card {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  min-height: 188rpx;
  padding: 0;
}

.meal-accent {
  width: 6rpx;
  flex-shrink: 0;
}
.tone-pink   { background: #FF83B7; }
.tone-mint   { background: #7FA66A; }
.tone-purple { background: #8B6CFF; }
.tone-gold   { background: #E4A543; }

.meal-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 18rpx;
  gap: 6rpx;
}

.meal-emoji-lg {
  font-size: 52rpx;
  line-height: 1;
}

.meal-name-lg {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.meal-kcal-row {
  display: flex;
  align-items: baseline;
}

.meal-kcal-big {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 700;
}

.kcal-dim { color: #C4B8D0; }

.meal-kcal-u {
  color: #807987;
  font-size: 22rpx;
}

.meal-status-tag {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-done {
  color: #7FA66A;
  background: #EAF3E4;
}

.tag-todo {
  color: #C4B8D0;
  background: #F5F1ED;
}
