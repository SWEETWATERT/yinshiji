.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.report-entry {
  width: 92rpx;
  height: 72rpx;
  border-radius: 28rpx;
  color: #6f5acb;
  font-size: 24rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 28rpx rgba(116, 89, 126, 0.12);
}

.score-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 46rpx;
}

.soft-label {
  color: #8d7d91;
  font-size: 24rpx;
  font-weight: 700;
}

.score {
  margin-top: 8rpx;
  font-size: 112rpx;
  line-height: 1;
  font-weight: 900;
  color: #b46add;
}

.score-copy {
  color: #8d7d91;
  font-size: 24rpx;
  font-weight: 800;
}

.score-ring {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 164rpx;
  height: 164rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 54rpx;
  background: conic-gradient(from 20deg, #ff9ec7, #9c8bea, #9fe7cc, #ffd982, #ff9ec7);
  box-shadow: 0 0 34rpx rgba(255, 158, 199, 0.42), 0 0 0 18rpx rgba(255, 255, 255, 0.28);
}

.s1 { left: 20rpx; top: 28rpx; }
.s2 { right: 26rpx; top: 44rpx; }
.s3 { right: 42rpx; bottom: 22rpx; }

.calorie-card,
.nutrition-card {
  margin-top: 24rpx;
  padding: 34rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  color: #43364d;
  font-size: 30rpx;
  font-weight: 900;
}

.card-head text:last-child {
  color: #8d7d91;
  font-size: 24rpx;
}

.calorie-main {
  margin: 26rpx 0 20rpx;
  font-size: 52rpx;
  font-weight: 900;
}

.calorie-main text {
  color: #8d7d91;
  font-size: 36rpx;
}

.nutrition-row {
  display: grid;
  grid-template-columns: 104rpx 82rpx 1fr;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  color: #43364d;
  font-size: 24rpx;
  font-weight: 800;
}

.meal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-top: 28rpx;
  padding-bottom: 86rpx;
}

.meal-card {
  position: relative;
  min-height: 236rpx;
  overflow: hidden;
  padding: 24rpx;
  border-radius: 38rpx;
  color: #fff;
  box-shadow: 0 20rpx 38rpx rgba(100, 72, 114, 0.16);
}

.meal-card.pink { background: linear-gradient(135deg, #ffc4dc, #c693eb); }
.meal-card.mint { background: linear-gradient(135deg, #a9efd4, #8c78df); }
.meal-card.purple { background: linear-gradient(135deg, #d4cdfc, #8670db); }
.meal-card.gold { background: linear-gradient(135deg, #f5cf7c, #ef98bf); }

.meal-thumb {
  width: 86rpx;
  height: 86rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.28);
  font-size: 42rpx;
}

.meal-status {
  display: inline-flex;
  margin-top: 26rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.25);
  font-size: 22rpx;
  font-weight: 800;
}

.meal-name {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.meal-kcal {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.camera-fab {
  position: fixed;
  left: 50%;
  bottom: 38rpx;
  transform: translateX(-50%);
  width: 124rpx;
  height: 124rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 44rpx;
  background: linear-gradient(135deg, #ff8fc0, #9c8bea 54%, #95e5ca);
  box-shadow: 0 18rpx 44rpx rgba(169, 108, 184, 0.36), 0 0 36rpx rgba(255, 158, 199, 0.68);
}
