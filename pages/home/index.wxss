.home-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.ai-home-page {
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
}

/* ── Header ── */
.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.ai-home-header {
  margin-bottom: 22rpx;
}

.report-btn {
  flex: 0 0 auto;
  width: 132rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  border: 2rpx solid #26302A;
  background: #FFFFFF;
  color: #26302A;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

/* ── AI Center ── */
.ai-center-card {
  padding: 32rpx;
  border-color: #DFEEE5;
  background: #FBFDFC;
}

.ai-center-empty {
  border-color: #ECE6F2;
  background: #FFFFFF;
}

.ai-center-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.ai-center-kicker {
  color: #256850;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.ai-center-title {
  margin-top: 8rpx;
  color: #25232A;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.18;
}

.ai-center-grade {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #58A27F;
  font-size: 23rpx;
  font-weight: 800;
}

.ai-score-hero {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 30rpx;
}

.ai-score-main-num {
  color: #256850;
  font-size: 116rpx;
  font-weight: 900;
  line-height: 0.95;
}

.ai-score-main-unit {
  color: #5F6762;
  font-size: 34rpx;
  font-weight: 800;
}

.ai-center-evaluation {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #24362D;
  background: #F4FAF6;
  border: 1rpx solid #DFEEE5;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.55;
}

.ai-center-section {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #E9EEEB;
}

.ai-center-section-title {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.ai-center-issue-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.ai-center-issue,
.ai-center-advice {
  color: #5F6762;
  background: #FFFFFF;
  border: 1rpx solid #EDF1EE;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.ai-center-advice {
  margin-top: 12rpx;
  color: #4C3E62;
  background: #FFFCFE;
  border-color: rgba(139, 108, 255, 0.16);
}

.ai-center-nutrition {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 26rpx;
}

.ai-center-nutrition-item {
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF1EE;
  text-align: center;
}

.ai-center-nutrition-label {
  display: block;
  color: #807987;
  font-size: 20rpx;
  line-height: 1.25;
}

.ai-center-nutrition-value {
  display: block;
  margin-top: 6rpx;
  color: #25232A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
}

.ai-center-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 26rpx;
}

.ai-center-streak {
  color: #807987;
  font-size: 23rpx;
  line-height: 1.4;
}

.ai-center-action {
  flex: 0 0 auto;
  min-width: 152rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #8B6CFF;
  font-size: 25rpx;
  font-weight: 800;
  border: none;
}

.weight-progress-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #DFEEE5;
}

.weight-progress-label {
  color: #256850;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.weight-progress-text {
  margin-top: 6rpx;
  color: #25232A;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.weight-progress-link {
  flex: 0 0 auto;
  color: #8B6CFF;
  font-size: 23rpx;
  font-weight: 900;
}

.fat-loss-card {
  padding: 28rpx;
  margin-top: 22rpx;
  border-color: #DFEEE5;
  background: #FBFDFC;
}

.fat-loss-card.status-warning {
  border-color: #F0D89A;
  background: #FFFCF4;
}

.fat-loss-card.status-danger {
  border-color: #F0D6DC;
  background: #FFFCFC;
}

.fat-loss-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.fat-loss-kicker {
  color: #256850;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.fat-loss-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  color: #25232A;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
}

.fat-loss-refresh {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #E8F5EF;
  font-size: 22rpx;
  font-weight: 800;
}

.fat-loss-status-text {
  margin-top: 16rpx;
  color: #5F6762;
  font-size: 25rpx;
  line-height: 1.5;
}

.fat-loss-metrics,
.weekly-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.fat-loss-metrics {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.fat-loss-metric,
.weekly-item {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF1EE;
}

.fat-loss-metric-label,
.weekly-label {
  display: block;
  color: #807987;
  font-size: 20rpx;
  line-height: 1.25;
}

.fat-loss-metric-value,
.weekly-value {
  display: block;
  margin-top: 8rpx;
  color: #25232A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.fat-loss-advice,
.weekly-insight {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E9EEEB;
}

.fat-loss-section-label {
  color: #25232A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
}

.fat-loss-advice-text {
  margin-top: 10rpx;
  color: #4C3E62;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.55;
}

.fat-loss-next,
.weekly-summary {
  margin-top: 10rpx;
  color: #5F6762;
  font-size: 24rpx;
  line-height: 1.55;
}

.fat-loss-streak {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  color: #7A4A00;
  background: #FFF1C7;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

/* ── Hero Score Card ── */
.hero-card {
  width: 100%;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FF83B7 0%, #8B6CFF 100%);
  box-shadow: 0 12rpx 32rpx rgba(139, 108, 255, 0.22);
  margin-top: 24rpx;
  margin-bottom: 4rpx;
}

.hero-card-empty {
  background: #FFFFFF;
  border: 1rpx solid #E9E1D8;
  box-shadow: 0 2rpx 12rpx rgba(37, 35, 42, 0.05);
}

.hero-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-label {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.hero-score-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin: 10rpx 0;
}

.hero-score {
  color: #fff;
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-unit {
  color: rgba(255, 255, 255, 0.90);
  font-size: 34rpx;
  font-weight: 700;
}

.hero-praise {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  font-weight: 400;
}

.hero-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.25);
  margin: 20rpx 0;
}

.hero-stat-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.hero-stat-label {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
}

.hero-stat-val {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-card-empty .hero-label,
.hero-card-empty .hero-praise {
  color: #807987;
}

.hero-empty-title {
  margin: 14rpx 0 10rpx;
  color: #25232A;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

/* ── Intake Card ── */
.intake-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* ── Streak ── */
.streak-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
  border-color: #E3EEDB;
  background: #FDFFFC;
}

.streak-card.status-pending {
  border-color: #F0D89A;
  background: #FFFCF4;
}

.streak-card.status-restart {
  border-color: #EFE0E0;
  background: #FFFCFC;
}

.streak-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.streak-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.streak-sub {
  margin-top: 8rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.streak-status {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #8A5D00;
  background: #FFF1C7;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.streak-status.checked {
  color: #256850;
  background: #E8F5EF;
}

.streak-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
}

.streak-days {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.streak-num {
  color: #256850;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
}

.streak-unit {
  color: #5F6762;
  font-size: 30rpx;
  font-weight: 700;
}

.streak-meta {
  color: #807987;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

/* ── AI Daily ── */
.ai-daily-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
  border-color: #dfeee5;
  background: #fbfdfc;
}

.ai-daily-empty {
  border-color: #ece6f2;
  background: #ffffff;
}

.ai-daily-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.ai-daily-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.ai-daily-sub {
  margin-top: 6rpx;
  color: #5f6762;
  font-size: 24rpx;
  line-height: 1.35;
}

.ai-daily-score {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 22rpx;
  background: #eff8f2;
  border: 1rpx solid #d9ebe0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ai-daily-score-num {
  color: #256850;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.ai-daily-score-unit {
  margin-top: 4rpx;
  color: #7a837f;
  font-size: 20rpx;
}

.ai-daily-macro {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.ai-daily-macro-item {
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #edf1ee;
  text-align: center;
}

.ai-daily-macro-label {
  display: block;
  color: #807987;
  font-size: 20rpx;
  line-height: 1.25;
}

.ai-daily-macro-value {
  display: block;
  margin-top: 6rpx;
  color: #25232A;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  word-break: break-all;
}

.ai-daily-error {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #8a5d00;
  background: #fff6dc;
  font-size: 23rpx;
  line-height: 1.45;
}

.ai-daily-section {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e9eeeb;
}

.ai-daily-section-label {
  color: #25232A;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.ai-daily-text {
  margin-top: 8rpx;
  color: #5f6762;
  font-size: 24rpx;
  line-height: 1.6;
}

.ai-issue-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.ai-issue-pill {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #61470f;
  background: #fff1c7;
  font-size: 22rpx;
  line-height: 1.3;
}

.ai-combo {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #edf1ee;
}

.ai-combo-title {
  color: #24362d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.ai-combo-foods {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.ai-combo-food {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #e8f5ef;
  font-size: 21rpx;
  line-height: 1.3;
}

.ai-combo-reason {
  margin-top: 10rpx;
  color: #7a837f;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ── Share Card ── */
.share-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
  border-color: rgba(139, 108, 255, 0.18);
  background: #FFFCFE;
}

.share-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.share-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.share-sub {
  margin-top: 6rpx;
  color: #807987;
  font-size: 23rpx;
  line-height: 1.45;
}

.share-button {
  flex: 0 0 auto;
  min-width: 116rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #8B6CFF;
  font-size: 24rpx;
  font-weight: 700;
  border: none;
}

.share-score-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.share-score {
  color: #8B6CFF;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
}

.share-score-unit {
  color: #807987;
  font-size: 24rpx;
  font-weight: 700;
}

.share-score-title {
  color: #25232A;
  font-size: 25rpx;
  font-weight: 800;
}

.share-nutrition {
  margin-top: 12rpx;
  color: #5F6762;
  font-size: 24rpx;
  line-height: 1.5;
}

.share-evaluation {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  color: #5F576A;
  background: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.55;
}

/* ── First Use Guide ── */
.guide-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  border-color: rgba(139, 108, 255, 0.18);
  background: #FFFCFE;
}

.guide-mark {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF83B7 0%, #8B6CFF 100%);
}

.guide-copy {
  flex: 1;
  min-width: 0;
}

.guide-title {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.guide-desc {
  margin-top: 6rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.5;
}

.guide-action {
  flex: 0 0 auto;
  color: #8B6CFF;
  font-size: 25rpx;
  font-weight: 700;
}

.intake-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.intake-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #EEE8FF;
  color: #8B6CFF;
  font-size: 24rpx;
  font-weight: 700;
}

.calorie-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.calorie-big {
  color: #25232A;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.calorie-sep {
  color: #807987;
  font-size: 28rpx;
  font-weight: 400;
}

.remain-txt {
  display: block;
  margin-top: 14rpx;
  color: #807987;
  font-size: 26rpx;
}

/* ── Module Title ── */
.module-title {
  color: #25232A;
  font-size: 34rpx;
  font-weight: 700;
  margin: 4rpx 0 18rpx;
}

/* ── Nutrition Grid 2×2 ── */
.nutri-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.nutri-card {
  padding: 24rpx 22rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nutri-hd {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ndot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.ndot-purple { background: #8B6CFF; }
.ndot-amber  { background: #E4A543; }
.ndot-green  { background: #7FA66A; }
.ndot-teal   { background: #5BBFBD; }

.nutri-name {
  color: #807987;
  font-size: 25rpx;
  font-weight: 500;
}

.nutri-num-row {
  display: flex;
  align-items: baseline;
  gap: 3rpx;
}

.nutri-big {
  color: #25232A;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.nutri-g {
  color: #807987;
  font-size: 22rpx;
  font-weight: 500;
}

.nutri-goal {
  color: #807987;
  font-size: 22rpx;
}

.nutri-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: #E9E1D8;
  overflow: hidden;
}

.nbar-fill {
  height: 100%;
  border-radius: 999rpx;
}
.nbar-purple { background: #8B6CFF; }
.nbar-amber  { background: #E4A543; }
.nbar-green  { background: #7FA66A; }
.nbar-teal   { background: #5BBFBD; }

/* ── AI Trend ── */
.trend-card {
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.trend-summary {
  color: #5F6762;
  font-size: 24rpx;
  line-height: 1.55;
  margin-bottom: 12rpx;
}

.trend-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #F0ECE7;
}

.trend-row:first-of-type {
  border-top: 0;
}

.trend-date {
  flex: 0 0 72rpx;
  color: #25232A;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
}

.trend-bars {
  flex: 1;
  min-width: 0;
}

.trend-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.trend-line:first-child {
  margin-top: 0;
}

.trend-label {
  flex: 0 0 52rpx;
  color: #807987;
  font-size: 20rpx;
}

.trend-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #EFE7DE;
  overflow: hidden;
}

.trend-fill {
  height: 100%;
  min-width: 4rpx;
  border-radius: 999rpx;
}

.kcal-fill { background: #E4A543; }
.protein-fill { background: #8B6CFF; }
.fat-fill { background: #7FA66A; }

.trend-value {
  flex: 0 0 74rpx;
  color: #25232A;
  font-size: 21rpx;
  font-weight: 700;
  text-align: right;
}

/* ── AI Insight ── */
.insight-card {
  padding: 26rpx;
  margin-bottom: 28rpx;
  border-color: #DFEEE5;
  background: #FBFDFC;
}

.insight-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.insight-summary {
  margin-top: 8rpx;
  color: #5F6762;
  font-size: 24rpx;
  line-height: 1.55;
}

.insight-section {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E9EEEB;
}

.insight-label {
  color: #25232A;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.insight-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.insight-pill {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #E8F5EF;
  font-size: 22rpx;
  line-height: 1.3;
}

.insight-line {
  position: relative;
  padding-left: 20rpx;
  margin-top: 10rpx;
  color: #5F6762;
  font-size: 23rpx;
  line-height: 1.55;
}

.insight-line::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #7FA66A;
}

/* ── Record Entry ── */
.record-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 28rpx;
}

.rec-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FF83B7 0%, #8B6CFF 100%);
}

.rec-icon-char {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.rec-text { flex: 1; min-width: 0; }

.rec-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.rec-sub {
  margin-top: 6rpx;
  color: #807987;
  font-size: 25rpx;
}

.rec-arrow {
  color: #C4B8D0;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 300;
}

/* ── Meal Grid ── */
.meal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.meal-card {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  min-height: 188rpx;
  padding: 0;
}

.meal-accent {
  width: 6rpx;
  flex-shrink: 0;
}
.tone-pink   { background: #FF83B7; }
.tone-mint   { background: #7FA66A; }
.tone-purple { background: #8B6CFF; }
.tone-gold   { background: #E4A543; }

.meal-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 18rpx;
  gap: 6rpx;
}

.meal-emoji-lg {
  font-size: 52rpx;
  line-height: 1;
}

.meal-name-lg {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.meal-kcal-row {
  display: flex;
  align-items: baseline;
}

.meal-kcal-big {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 700;
}

.kcal-dim { color: #C4B8D0; }

.meal-kcal-u {
  color: #807987;
  font-size: 22rpx;
}

.meal-status-tag {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-done {
  color: #7FA66A;
  background: #EAF3E4;
}

.tag-todo {
  color: #C4B8D0;
  background: #F5F1ED;
}
