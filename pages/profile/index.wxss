.profile-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.user-card {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 24rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 80rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  font-size: 34rpx;
  line-height: 1;
  background: #fff0f5;
}

.user-main {
  min-width: 0;
}

.nickname {
  color: #2f2936;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.setting-card {
  margin-top: 24rpx;
  overflow: hidden;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f0edf2;
  color: #2f2936;
  font-size: 26rpx;
  text-align: left;
  background: #fff;
}

.setting-row.last {
  border-bottom: 0;
}

.setting-row.danger {
  color: #d85c76;
  border-top: 1rpx solid #f0edf2;
  border-bottom: 0;
}

.setting-label {
  flex: 1;
  font-weight: 400;
  text-align: left;
  white-space: nowrap;
}

.setting-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  min-width: 176rpx;
  color: #8c8498;
  font-size: 26rpx;
  text-align: right;
  white-space: nowrap;
}

.setting-right.compact {
  min-width: 40rpx;
}

.arrow {
  color: #b8b1c0;
  font-size: 34rpx;
  line-height: 1;
}

.goal-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.goal-copy,
.privacy-copy {
  margin-top: 10rpx;
  color: #8c8498;
  font-size: 26rpx;
  line-height: 1.55;
}

.privacy-row {
  padding: 28rpx;
}

.login-button {
  margin-top: 28rpx;
}
