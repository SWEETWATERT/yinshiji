<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.12;"></image>
</view>
<view class="page page-container profile-page">

  <!-- Brand Header -->
  <brand-header></brand-header>

  <!-- Header -->
  <view class="page-title">我的</view>
  <view class="page-subtitle">个人目标与饮食偏好</view>

  <!-- User Card -->
  <view class="user-card section-card">
    <view class="user-card-left">
      <image wx:if="{{!avatarLoadError && avatarUrl}}" class="user-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
      <view wx:else class="user-avatar avatar-fallback">{{avatarFallbackText}}</view>
      <view class="user-info">
        <view class="user-name">{{displayName}}</view>
        <view class="user-tag">{{user.healthGoal || '健康饮食'}} · {{genderText}}</view>
        <view class="user-streak">BMI {{user.bmi || '--'}} · {{user.bmiLevel || '待测'}}</view>
      </view>
    </view>
    <image wx:if="{{characterUrl}}" class="user-character" src="{{characterUrl}}" mode="aspectFit" binderror="onCharacterError"></image>
  </view>

  <!-- Body Data 2×2 -->
  <view class="profile-section-hd">
    <text class="module-title">身体数据</text>
    <button class="edit-profile-btn" bindtap="goEditProfile">编辑</button>
  </view>
  <view class="data-grid">
    <view class="data-card section-card">
      <text class="data-label">身高</text>
      <view class="data-num-row">
        <text class="data-big">{{user.heightCm || '--'}}</text>
        <text class="data-unit">cm</text>
      </view>
    </view>
    <view class="data-card section-card">
      <text class="data-label">体重</text>
      <view class="data-num-row">
        <text class="data-big">{{user.weightKg || '--'}}</text>
        <text class="data-unit">kg</text>
      </view>
    </view>
    <view class="data-card section-card">
      <text class="data-label">每日热量目标</text>
      <view class="data-num-row">
        <text class="data-big">{{user.calorieTarget || 1800}}</text>
        <text class="data-unit">kcal</text>
      </view>
    </view>
    <view class="data-card section-card">
      <text class="data-label">蛋白质目标</text>
      <view class="data-num-row">
        <text class="data-big">{{user.proteinTarget || 90}}</text>
        <text class="data-unit">g</text>
      </view>
    </view>
  </view>

  <!-- Diet Mode Card -->
  <view class="mode-card section-card">
    <view class="mode-accent"></view>
    <view class="mode-inner">
      <view class="mode-hd">
        <text class="mode-name">我的饮食模式</text>
        <text class="mode-badge">{{user.healthGoal || '轻盈健康'}}</text>
      </view>
      <text class="mode-desc">
        优先补足蛋白质和蔬菜摄入，减少含糖饮料，保持规律记录。
      </text>
    </view>
  </view>

  <!-- Preference Card -->
  <view class="preference-card section-card">
    <view class="preference-title">我的饮食偏好</view>
    <view class="preference-desc">后续营养建议会优先参考这些方向。</view>
    <view class="preference-chips">
      <view class="chip chip-active">{{user.healthGoal || '轻盈健康'}}</view>
      <view class="chip">少油</view>
      <view class="chip">高蛋白</view>
      <view class="chip">多蔬菜</view>
    </view>
  </view>

  <!-- Admin Entry -->
  <view wx:if="{{user.isAdmin}}" class="admin-entry section-card" bindtap="goAdmin">
    <view>
      <view class="admin-title">后台管理</view>
      <view class="admin-desc">数据看板、AI 复核、食物库和配置管理</view>
    </view>
    <text class="admin-arr">›</text>
  </view>

  <!-- Privacy Section -->
  <view class="privacy-section section-card">
    <view class="privacy-hd">数据与隐私</view>
    <button class="setting-row" bindtap="goEditProfile">
      <text class="setting-label">编辑身体资料</text>
      <text class="setting-arr">›</text>
    </button>
    <button class="setting-row setting-row-last" bindtap="showSettingToast">
      <text class="setting-label">设置</text>
      <text class="setting-arr">›</text>
    </button>
  </view>

</view>
