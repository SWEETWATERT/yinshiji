<view class="page page-container profile-page">
  <view class="page-title">我的</view>
  <view class="page-subtitle">个人目标与饮食偏好</view>

  <view class="user-card section-card">
    <view class="avatar">🌸</view>
    <view class="user-main">
      <view class="nickname">{{user.nickname}}</view>
      <view class="muted">微信 mock 登录 · 后续接入真实授权</view>
    </view>
  </view>

  <view class="section-card setting-card">
    <button class="setting-row" bindtap="showSettingToast">
      <text class="setting-label">身高</text>
      <view class="setting-right"><text>{{user.height}} cm</text><text class="arrow">›</text></view>
    </button>
    <button class="setting-row" bindtap="showSettingToast">
      <text class="setting-label">体重</text>
      <view class="setting-right"><text>{{user.weight}} kg</text><text class="arrow">›</text></view>
    </button>
    <button class="setting-row" bindtap="showSettingToast">
      <text class="setting-label">每日热量目标</text>
      <view class="setting-right"><text>{{user.calorieTarget}} kcal</text><text class="arrow">›</text></view>
    </button>
    <button class="setting-row last" bindtap="showSettingToast">
      <text class="setting-label">蛋白质目标</text>
      <view class="setting-right"><text>{{user.proteinTarget}} g</text><text class="arrow">›</text></view>
    </button>
  </view>

  <view class="goal-card section-card">
    <view class="section-title">饮食目标</view>
    <view class="goal-copy">保持规律记录，优先补足蛋白质和蔬菜摄入，减少含糖饮料。</view>
  </view>

  <view class="section-card setting-card">
    <view class="privacy-row">
      <view class="section-title">隐私说明</view>
      <view class="privacy-copy">当前版本仅使用本地 mock 数据，餐食记录保存在本机缓存中。</view>
    </view>
    <button class="setting-row danger" bindtap="clearLocalData">
      <text class="setting-label">清除本地数据</text>
      <view class="setting-right compact"><text class="arrow">›</text></view>
    </button>
  </view>

  <button class="primary-button login-button" bindtap="mockRelogin">重新登录</button>
</view>
