.meal-detail-page {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.detail-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 24rpx 0;
}

.nav-back-btn {
  flex: 0 0 auto;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border: none;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.76);
  color: #5f576a;
  font-size: 26rpx;
  box-shadow: none;
}

.state-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 32rpx;
}

.state-title {
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 700;
}

.state-text {
  color: #8c8498;
  font-size: 24rpx;
  line-height: 1.6;
}

.error-card {
  border: 1rpx solid #ffd6df;
  background: #fff7f9;
}

.hero-card {
  padding: 0;
  overflow: hidden;
}

.meal-image {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #f7f2ea;
}

.meal-image-empty {
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f2ea;
  font-size: 72rpx;
}

.hero-info {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
}

.meal-name {
  display: block;
  color: #2f2936;
  font-size: 34rpx;
  font-weight: 700;
}

.meal-date {
  display: block;
  margin-top: 8rpx;
  color: #8c8498;
  font-size: 24rpx;
}

.score-pill {
  flex: 0 0 auto;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #e879b7 0%, #8b6cff 100%);
}

.note-box {
  margin: 0 28rpx 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #6f6578;
  font-size: 24rpx;
  line-height: 1.6;
  background: #faf7f8;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 0 28rpx 28rpx;
}

.edit-meal-btn,
.delete-meal-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  border: none;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.edit-meal-btn {
  color: #fff;
  background: linear-gradient(135deg, #e879b7 0%, #8b6cff 100%);
  box-shadow: 0 10rpx 22rpx rgba(139, 108, 255, 0.18);
}

.delete-meal-btn {
  color: #d85b73;
  background: #fff2f5;
  border: 1rpx solid #ffd6df;
}

.summary-card,
.meta-card,
.advice-card {
  padding: 28rpx;
}

.summary-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.card-title {
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 700;
}

.kcal-main {
  color: #8b6cff;
  font-size: 40rpx;
  font-weight: 800;
}

.macro-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.macro-item {
  padding: 16rpx 10rpx;
  border-radius: 16rpx;
  background: #faf7f8;
  text-align: center;
}

.macro-label {
  display: block;
  color: #8c8498;
  font-size: 22rpx;
}

.macro-value {
  display: block;
  margin-top: 6rpx;
  color: #2f2936;
  font-size: 26rpx;
  font-weight: 700;
}

.section-title {
  margin: 30rpx 0 16rpx;
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 700;
}

.food-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.food-card {
  padding: 22rpx;
}

.food-main-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.food-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f1f5;
  font-size: 30rpx;
}

.food-info {
  flex: 1;
  min-width: 0;
}

.food-name {
  display: block;
  color: #2f2936;
  font-size: 28rpx;
  font-weight: 700;
}

.food-meta {
  display: block;
  margin-top: 6rpx;
  color: #8c8498;
  font-size: 24rpx;
}

.food-macros {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  margin-top: 18rpx;
  color: #6f6578;
  font-size: 23rpx;
}

.food-source {
  margin-top: 14rpx;
  color: #9a90a4;
  font-size: 22rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0ecf4;
}

.meta-row:last-of-type {
  border-bottom: none;
}

.meta-label {
  color: #8c8498;
  font-size: 24rpx;
}

.meta-value {
  flex: 1;
  text-align: right;
  color: #2f2936;
  font-size: 24rpx;
  font-weight: 600;
}

.review-tip {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff8ec;
  color: #7a5500;
  font-size: 24rpx;
  line-height: 1.6;
}

.advice-text {
  display: block;
  margin-top: 16rpx;
  color: #6f6578;
  font-size: 24rpx;
  line-height: 1.7;
}
