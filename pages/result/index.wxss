.result-page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.meal-recognition-card {
  padding: 0;
  margin-top: 22rpx;
  overflow: hidden;
}

.meal-image-wrap {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  background: #F7F2EA;
}

.meal-image {
  width: 100%;
  height: 100%;
  display: block;
}

.meal-image-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: linear-gradient(180deg, rgba(37, 35, 42, 0) 0%, rgba(37, 35, 42, 0.35) 100%);
}

.meal-image-label {
  position: absolute;
  left: 22rpx;
  bottom: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: rgba(37, 35, 42, 0.45);
  font-size: 22rpx;
  font-weight: 800;
}

.meal-no-image {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 34rpx 28rpx;
  color: #5F6762;
  background: #FBFDFC;
  font-size: 25rpx;
}

.meal-no-image-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  color: #FFFFFF;
  background: #8B6CFF;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
}

.recognition-body {
  padding: 28rpx;
  border-color: #dfeee5;
  background: #fbfdfc;
}

.score-card {
  padding: 30rpx;
  margin-top: 20rpx;
  border-color: #dfeee5;
  background: #fbfdfc;
}

.score-head,
.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.result-kicker {
  color: #256850;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.score-title {
  margin-top: 8rpx;
  color: #25232A;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
}

.result-grade {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #58A27F;
  font-size: 23rpx;
  font-weight: 800;
}

.recognized-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.recognized-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #E8F5EF;
  font-size: 24rpx;
  font-weight: 800;
}

.recognized-empty,
.recognition-note {
  color: #807987;
  font-size: 23rpx;
  line-height: 1.5;
}

.recognition-note {
  margin-top: 14rpx;
}

.score-layout {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 26rpx;
}

.score-ring {
  flex: 0 0 auto;
  width: 172rpx;
  height: 172rpx;
  border-radius: 50%;
  padding: 12rpx;
  background: conic-gradient(#58A27F 0 78%, #E5EFE9 78% 100%);
  box-sizing: border-box;
}

.score-ring-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.result-score {
  color: #256850;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.result-score-unit {
  color: #5F6762;
  font-size: 22rpx;
  font-weight: 800;
}

.score-copy {
  flex: 1;
  min-width: 0;
  color: #24362D;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
}

.insight-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.insight-block {
  min-width: 0;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF1EE;
}

.strength-block {
  border-color: #DFEEE5;
}

.problem-block {
  border-color: #F0D89A;
}

.insight-title {
  color: #25232A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.insight-line {
  position: relative;
  margin-top: 10rpx;
  padding-left: 18rpx;
  color: #5F6762;
  font-size: 22rpx;
  line-height: 1.5;
}

.insight-line::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #58A27F;
}

.advice-card,
.summary-card,
.foods-card,
.warning-card,
.state-card {
  padding: 26rpx;
  margin-top: 20rpx;
}

.advice-card {
  border-color: rgba(139, 108, 255, 0.16);
  background: #FFFCFE;
}

.card-title {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.advice-text {
  margin-top: 12rpx;
  color: #4C3E62;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.6;
}

.next-meal-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(139, 108, 255, 0.16);
}

.next-meal-label {
  color: #8B6CFF;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.3;
}

.next-meal-text {
  margin-top: 8rpx;
  color: #25232A;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.55;
}

.kcal-pill {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #E8F5EF;
  font-size: 23rpx;
  font-weight: 800;
}

.macro-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.macro-item {
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
  text-align: center;
}

.macro-label {
  display: block;
  color: #807987;
  font-size: 20rpx;
  line-height: 1.25;
}

.macro-value {
  display: block;
  margin-top: 6rpx;
  color: #25232A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.food-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #F0ECE7;
}

.food-row:first-of-type {
  border-top: 0;
}

.food-icon {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.food-copy {
  flex: 1;
  min-width: 0;
}

.food-name {
  color: #25232A;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.food-meta,
.empty-foods,
.state-text {
  margin-top: 6rpx;
  color: #807987;
  font-size: 23rpx;
  line-height: 1.5;
}

.warning-line {
  margin-top: 10rpx;
  color: #8A5D00;
  font-size: 23rpx;
  line-height: 1.5;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 800;
}

.result-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid #EFE7DE;
}

.primary-action,
.secondary-action {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
  border: none;
}

.primary-action {
  color: #fff;
  background: #8B6CFF;
}

.primary-action[disabled] {
  opacity: 0.56;
}

.secondary-action {
  color: #6B6570;
  background: #F5F1ED;
}
