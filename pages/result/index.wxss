.result-page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.result-hero {
  padding: 32rpx;
  margin-top: 22rpx;
  border-color: #dfeee5;
  background: #fbfdfc;
}

.result-head,
.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.result-kicker {
  color: #256850;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.result-title {
  margin-top: 8rpx;
  color: #25232A;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.18;
}

.result-grade {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #58A27F;
  font-size: 23rpx;
  font-weight: 800;
}

.result-score-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 30rpx;
}

.result-score {
  color: #256850;
  font-size: 116rpx;
  font-weight: 900;
  line-height: 0.95;
}

.result-score-unit {
  color: #5F6762;
  font-size: 34rpx;
  font-weight: 800;
}

.result-explanation {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #24362D;
  background: #F4FAF6;
  border: 1rpx solid #DFEEE5;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.55;
}

.confidence-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #807987;
  font-size: 23rpx;
  line-height: 1.4;
}

.advice-card,
.summary-card,
.foods-card,
.warning-card,
.state-card {
  padding: 26rpx;
  margin-top: 20rpx;
}

.advice-card {
  border-color: rgba(139, 108, 255, 0.16);
  background: #FFFCFE;
}

.card-title {
  color: #25232A;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.advice-text {
  margin-top: 12rpx;
  color: #4C3E62;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.6;
}

.kcal-pill {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #E8F5EF;
  font-size: 23rpx;
  font-weight: 800;
}

.macro-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.macro-item {
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
  text-align: center;
}

.macro-label {
  display: block;
  color: #807987;
  font-size: 20rpx;
  line-height: 1.25;
}

.macro-value {
  display: block;
  margin-top: 6rpx;
  color: #25232A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.food-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #F0ECE7;
}

.food-row:first-of-type {
  border-top: 0;
}

.food-icon {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.food-copy {
  flex: 1;
  min-width: 0;
}

.food-name {
  color: #25232A;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.food-meta,
.empty-foods,
.state-text {
  margin-top: 6rpx;
  color: #807987;
  font-size: 23rpx;
  line-height: 1.5;
}

.warning-line {
  margin-top: 10rpx;
  color: #8A5D00;
  font-size: 23rpx;
  line-height: 1.5;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 800;
}

.result-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid #EFE7DE;
}

.primary-action,
.secondary-action {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
  border: none;
}

.primary-action {
  color: #fff;
  background: #8B6CFF;
}

.primary-action[disabled] {
  opacity: 0.56;
}

.secondary-action {
  color: #6B6570;
  background: #F5F1ED;
}
