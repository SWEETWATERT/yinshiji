<view class="page-bg-layer">
  <image class="page-bg-img" src="/assets/bg-silhouette-abstract.png" mode="aspectFill" style="opacity:0.08;"></image>
</view>

<view class="page page-container progress-page">
  <brand-header></brand-header>

  <view class="progress-header">
    <view>
      <view class="page-title">减脂进度</view>
      <view class="page-subtitle">记录体重，查看距离目标还差多少</view>
    </view>
    <button class="refresh-button" bindtap="refreshProgress" disabled="{{loading || saving}}">
      {{loading ? '读取中' : '刷新'}}
    </button>
  </view>

  <view wx:if="{{loading}}" class="progress-card section-card state-card">
    <view class="state-title">正在读取进度</view>
    <view class="state-text">同步你的减脂目标和最近体重记录。</view>
  </view>

  <view wx:elif="{{error}}" class="progress-card section-card state-card error-card">
    <view class="state-title">{{error}}</view>
    <view class="state-text">请确认云数据库集合 weight_records 已创建。</view>
    <button class="retry-button" bindtap="refreshProgress">重试</button>
  </view>

  <block wx:else>
    <view wx:if="{{!hasGoal}}" class="progress-card section-card state-card">
      <view class="state-title">还没有减脂目标</view>
      <view class="state-text">先设置当前体重、目标体重和周期，系统会用目标计算进度。</view>
      <button class="primary-mini-button" bindtap="goGoal">设置减脂目标</button>
    </view>

    <block wx:else>
      <view class="progress-hero section-card">
        <view class="hero-topline">
          <view>
            <view class="hero-label">减脂目标</view>
            <view class="hero-title">{{progress.currentWeightText}} → {{progress.targetWeightText}} kg</view>
          </view>
          <view class="hero-target">预计 {{targetDateInfo.dateText}}</view>
        </view>

        <view class="hero-main-grid">
          <view class="goal-ring" style="background: conic-gradient(#58A27F 0 {{progress.progressPercent}}%, #E5EFE9 {{progress.progressPercent}}% 100%);">
            <view class="goal-ring-inner">
              <text class="goal-percent">{{progress.progressPercent}}</text>
              <text class="goal-percent-unit">%</text>
            </view>
          </view>

          <view class="hero-copy">
            <view class="hero-current-label">当前体重</view>
            <view class="hero-weight">{{progress.currentWeightText}} kg</view>
            <view class="hero-target-date">{{targetDateInfo.desc}}</view>
          </view>
        </view>

        <view class="metric-grid">
          <view class="metric-item">
            <text class="metric-label">距离目标</text>
            <text class="metric-value">{{progress.remainingKgText}} kg</text>
          </view>
          <view class="metric-item">
            <text class="metric-label">已减重</text>
            <text class="metric-value">{{progress.lostKgText}} kg</text>
          </view>
          <view class="metric-item">
            <text class="metric-label">完成度</text>
            <text class="metric-value">{{progress.progressPercent}}%</text>
          </view>
        </view>
      </view>

      <view class="progress-card section-card curve-card">
        <view class="record-head">
          <view>
            <view class="card-title">下降曲线</view>
            <view class="card-subtitle">{{hasRecords ? '最近7次体重变化' : '记录体重后生成趋势'}}</view>
          </view>
          <view class="trend-badge {{trendSummary.isDown ? 'trend-down' : ''}}">{{trendSummary.changeText}}</view>
        </view>

        <view wx:if="{{!curvePoints.length}}" class="empty-records">
          暂无曲线数据。保存今日体重后，系统会开始生成目标进度曲线。
        </view>

        <view wx:else class="curve-stage">
          <view class="curve-grid-line top"></view>
          <view class="curve-grid-line middle"></view>
          <view class="curve-grid-line bottom"></view>
          <block wx:for="{{curvePoints}}" wx:key="id">
            <view class="curve-column">
              <view class="curve-plot">
                <view class="curve-drop {{item.isLatest ? 'latest' : ''}}" style="height: {{item.dropHeight}}%;"></view>
                <view class="curve-point {{item.isLatest ? 'latest' : ''}}" style="top: {{item.top}}%;"></view>
              </view>
              <view class="curve-weight">{{item.weightText}}</view>
              <view class="curve-date">{{item.dateLabel}}</view>
            </view>
          </block>
        </view>
      </view>

      <view class="progress-card section-card milestones-card">
        <view class="card-title">里程碑</view>
        <view class="milestone-list">
          <block wx:for="{{milestones}}" wx:key="id">
            <view class="milestone-item {{item.done ? 'done' : 'pending'}}">
              <view class="milestone-dot"></view>
              <view class="milestone-copy">
                <view class="milestone-title">{{item.title}}</view>
                <view class="milestone-desc">{{item.desc}}</view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view wx:if="{{!hasRecords}}" class="progress-card section-card first-guide-card">
        <view class="card-title">第一次使用</view>
        <view class="guide-steps">
          <view class="guide-step">
            <text class="guide-step-num">1</text>
            <text class="guide-step-text">保存今天的真实体重</text>
          </view>
          <view class="guide-step">
            <text class="guide-step-num">2</text>
            <text class="guide-step-text">每天记录饮食，首页会生成减脂建议</text>
          </view>
          <view class="guide-step">
            <text class="guide-step-num">3</text>
            <text class="guide-step-text">连续记录后查看最近7次体重趋势</text>
          </view>
        </view>
      </view>

      <view class="progress-card section-card">
        <view class="card-title">新增今日体重</view>
        <view class="input-row">
          <input
            class="weight-input"
            type="digit"
            value="{{weightInput}}"
            bindinput="onWeightInput"
            placeholder="输入今日体重"
          />
          <text class="input-unit">kg</text>
        </view>
        <textarea
          class="note-input"
          value="{{noteInput}}"
          bindinput="onNoteInput"
          maxlength="80"
          placeholder="备注，可选"
          auto-height
        />
        <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveTodayWeight">
          {{saving ? '保存中' : '保存今日体重'}}
        </button>
      </view>

      <view class="progress-card section-card record-list-card">
        <view class="record-head">
          <view>
            <view class="card-title">最近 7 次体重趋势</view>
            <view class="card-subtitle">{{hasRecords ? '按日期倒序展示' : '记录后会显示在这里'}}</view>
          </view>
        </view>

        <view wx:if="{{!hasRecords}}" class="empty-records">
          暂无体重记录，当前进度先使用目标里的初始体重。保存今日体重后，会从这里开始形成趋势。
        </view>

        <block wx:else>
          <view class="trend-summary-card">
            <view class="trend-summary-title">{{trendSummary.title}}</view>
            <view class="trend-summary-desc">{{trendSummary.desc}}</view>
          </view>
          <block wx:for="{{records}}" wx:key="id">
            <view class="record-row">
              <view>
                <view class="record-date">{{item.date}}</view>
                <view wx:if="{{item.note}}" class="record-note">{{item.note}}</view>
              </view>
              <view class="record-weight">{{item.weightText}}</view>
            </view>
          </block>
        </block>
      </view>
    </block>
  </block>
</view>
