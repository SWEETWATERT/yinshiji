.progress-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.progress-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.refresh-button,
.retry-button,
.primary-mini-button {
  flex: 0 0 auto;
  min-width: 124rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #E8F5EF;
  font-size: 24rpx;
  font-weight: 800;
  border: none;
}

.refresh-button[disabled] {
  opacity: 0.6;
}

.progress-card,
.progress-hero {
  padding: 28rpx;
  margin-top: 22rpx;
}

.state-card {
  margin-top: 0;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.state-text,
.card-subtitle,
.record-note,
.empty-records {
  margin-top: 10rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.5;
}

.error-card {
  border-color: #F5D48A;
  background: #FFF8E5;
}

.retry-button,
.primary-mini-button {
  margin-top: 22rpx;
}

.primary-mini-button {
  color: #FFFFFF;
  background: #8B6CFF;
}

.progress-hero {
  position: relative;
  overflow: hidden;
  border-color: #DFEEE5;
  background: linear-gradient(145deg, #FBFDFC 0%, #FFFFFF 54%, #F1F7F3 100%);
}

.progress-hero::after {
  content: "";
  position: absolute;
  right: -72rpx;
  top: -84rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(88, 162, 127, 0.12);
}

.hero-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-label {
  color: #256850;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-title {
  margin-top: 8rpx;
  color: #25232A;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-weight {
  margin-top: 8rpx;
  color: #25232A;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.08;
}

.hero-target {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #58A27F;
  font-size: 23rpx;
  font-weight: 800;
}

.hero-main-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 190rpx minmax(0, 1fr);
  align-items: center;
  gap: 28rpx;
  margin-top: 30rpx;
}

.goal-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx rgba(88, 162, 127, 0.12);
  animation: ring-pop 420ms ease-out both;
}

.goal-ring-inner {
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(37, 35, 42, 0.08);
}

.goal-percent {
  color: #256850;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 130rpx;
}

.goal-percent-unit {
  color: #256850;
  font-size: 24rpx;
  font-weight: 900;
}

.hero-copy {
  min-width: 0;
}

.hero-current-label,
.hero-target-date {
  color: #807987;
  font-size: 24rpx;
  line-height: 1.45;
}

.hero-target-date {
  margin-top: 8rpx;
}

.progress-track {
  height: 18rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #E5EFE9;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
  background: #58A27F;
}

.metric-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 24rpx;
}

.metric-item {
  min-width: 0;
  padding: 16rpx 10rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF1EE;
  text-align: center;
}

.metric-label {
  display: block;
  color: #807987;
  font-size: 20rpx;
  line-height: 1.25;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  color: #25232A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.card-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.weight-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  color: #25232A;
  background: #F7F2EA;
  border: 1.5rpx solid #E9E1D8;
  font-size: 30rpx;
  font-weight: 800;
}

.input-unit {
  flex: 0 0 auto;
  color: #807987;
  font-size: 25rpx;
}

.note-input {
  width: 100%;
  min-height: 92rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  color: #25232A;
  background: #FAF8F5;
  border: 1.5rpx solid #EFE7DE;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.save-button {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #8B6CFF;
  font-size: 27rpx;
  font-weight: 900;
  border: none;
}

.save-button[disabled] {
  opacity: 0.6;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.empty-records {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
}

.first-guide-card {
  border-color: rgba(139, 108, 255, 0.16);
  background: #FFFCFE;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.guide-step {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.guide-step-num {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: #8B6CFF;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
}

.guide-step-text {
  color: #5F6762;
  font-size: 24rpx;
  line-height: 1.45;
}

.trend-badge {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #8A5D00;
  background: #FFF1C7;
  font-size: 23rpx;
  font-weight: 900;
}

.trend-down {
  color: #256850;
  background: #E8F5EF;
}

.trend-summary-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #FBFDFC;
  border: 1rpx solid #DFEEE5;
}

.trend-summary-title {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.trend-summary-desc {
  margin-top: 8rpx;
  color: #5F6762;
  font-size: 23rpx;
  line-height: 1.5;
}

.curve-card {
  overflow: hidden;
}

.curve-stage {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 252rpx;
  margin-top: 22rpx;
  padding: 18rpx 4rpx 4rpx;
}

.curve-grid-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: #F0ECE7;
}

.curve-grid-line.top {
  top: 24rpx;
}

.curve-grid-line.middle {
  top: 96rpx;
}

.curve-grid-line.bottom {
  top: 168rpx;
}

.curve-column {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  text-align: center;
}

.curve-plot {
  position: relative;
  height: 176rpx;
}

.curve-drop {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(88, 162, 127, 0.18), rgba(88, 162, 127, 0.72));
  transform: translateX(-50%);
}

.curve-drop.latest {
  width: 16rpx;
  background: linear-gradient(180deg, rgba(139, 108, 255, 0.20), rgba(139, 108, 255, 0.88));
}

.curve-point {
  position: absolute;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  background: #58A27F;
  box-shadow: 0 4rpx 12rpx rgba(88, 162, 127, 0.28);
  transform: translate(-50%, -50%);
}

.curve-point.latest {
  width: 22rpx;
  height: 22rpx;
  background: #8B6CFF;
  box-shadow: 0 4rpx 16rpx rgba(139, 108, 255, 0.32);
}

.curve-weight {
  margin-top: 10rpx;
  color: #25232A;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.curve-date {
  margin-top: 4rpx;
  color: #807987;
  font-size: 19rpx;
  line-height: 1.2;
}

.milestones-card {
  border-color: rgba(88, 162, 127, 0.16);
}

.milestone-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.milestone-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 86rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #FAF8F5;
  border: 1rpx solid #F0ECE7;
}

.milestone-item.done {
  background: #F0FAF5;
  border-color: #D8EEE2;
}

.milestone-dot {
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #D7D0C8;
  box-shadow: inset 0 0 0 8rpx #FAF8F5;
}

.milestone-item.done .milestone-dot {
  background: #58A27F;
  box-shadow: inset 0 0 0 7rpx #F0FAF5;
}

.milestone-copy {
  min-width: 0;
}

.milestone-title {
  color: #25232A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.milestone-desc {
  margin-top: 4rpx;
  color: #807987;
  font-size: 22rpx;
  line-height: 1.35;
}

.record-list-card {
  padding-bottom: 16rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 78rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0ECE7;
}

.record-row:last-child {
  border-bottom: 0;
}

.record-date {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.record-weight {
  flex: 0 0 auto;
  color: #256850;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

@keyframes ring-pop {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
