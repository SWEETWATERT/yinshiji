.progress-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.progress-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.refresh-button,
.retry-button,
.primary-mini-button {
  flex: 0 0 auto;
  min-width: 124rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #256850;
  background: #E8F5EF;
  font-size: 24rpx;
  font-weight: 800;
  border: none;
}

.refresh-button[disabled] {
  opacity: 0.6;
}

.progress-card,
.progress-hero {
  padding: 28rpx;
  margin-top: 22rpx;
}

.state-card {
  margin-top: 0;
}

.state-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.state-text,
.card-subtitle,
.record-note,
.empty-records {
  margin-top: 10rpx;
  color: #807987;
  font-size: 24rpx;
  line-height: 1.5;
}

.error-card {
  border-color: #F5D48A;
  background: #FFF8E5;
}

.retry-button,
.primary-mini-button {
  margin-top: 22rpx;
}

.primary-mini-button {
  color: #FFFFFF;
  background: #8B6CFF;
}

.progress-hero {
  border-color: #DFEEE5;
  background: #FBFDFC;
}

.hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-label {
  color: #256850;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-weight {
  margin-top: 8rpx;
  color: #25232A;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.08;
}

.hero-target {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #58A27F;
  font-size: 23rpx;
  font-weight: 800;
}

.progress-track {
  height: 18rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #E5EFE9;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
  background: #58A27F;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 24rpx;
}

.metric-item {
  min-width: 0;
  padding: 16rpx 10rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF1EE;
  text-align: center;
}

.metric-label {
  display: block;
  color: #807987;
  font-size: 20rpx;
  line-height: 1.25;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  color: #25232A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.card-title {
  color: #25232A;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.weight-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  color: #25232A;
  background: #F7F2EA;
  border: 1.5rpx solid #E9E1D8;
  font-size: 30rpx;
  font-weight: 800;
}

.input-unit {
  flex: 0 0 auto;
  color: #807987;
  font-size: 25rpx;
}

.note-input {
  width: 100%;
  min-height: 92rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  color: #25232A;
  background: #FAF8F5;
  border: 1.5rpx solid #EFE7DE;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.save-button {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #8B6CFF;
  font-size: 27rpx;
  font-weight: 900;
  border: none;
}

.save-button[disabled] {
  opacity: 0.6;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.empty-records {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
}

.first-guide-card {
  border-color: rgba(139, 108, 255, 0.16);
  background: #FFFCFE;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.guide-step {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.guide-step-num {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: #8B6CFF;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
}

.guide-step-text {
  color: #5F6762;
  font-size: 24rpx;
  line-height: 1.45;
}

.trend-badge {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #8A5D00;
  background: #FFF1C7;
  font-size: 23rpx;
  font-weight: 900;
}

.trend-down {
  color: #256850;
  background: #E8F5EF;
}

.trend-summary-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #FBFDFC;
  border: 1rpx solid #DFEEE5;
}

.trend-summary-title {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.trend-summary-desc {
  margin-top: 8rpx;
  color: #5F6762;
  font-size: 23rpx;
  line-height: 1.5;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 78rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0ECE7;
}

.record-row:last-child {
  border-bottom: 0;
}

.record-date {
  color: #25232A;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.record-weight {
  flex: 0 0 auto;
  color: #256850;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}
