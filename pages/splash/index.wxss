.splash-page {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #fff8fb 0%, #f3efff 52%, #eaf8f1 100%);
}

.splash-frame {
  position: absolute;
  inset: 0;
  width: 100vw;
  height: 100vh;
  display: block;
}

.splash-fallback {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #fff8fb 0%, #f3efff 52%, #eaf8f1 100%);
}

.splash-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.splash-logo {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  font-size: 54rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 48rpx rgba(137, 108, 255, 0.18);
}

.splash-title {
  color: #2d2838;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.splash-subtitle {
  margin-top: 12rpx;
  color: #8c8498;
  font-size: 26rpx;
}

.loading-bar {
  width: 220rpx;
  height: 8rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.loading-fill {
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(135deg, #f58bb8 0%, #8d7cf0 100%);
  animation: splash-loading 5s linear both;
  transform-origin: left center;
}

@keyframes splash-loading {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}
