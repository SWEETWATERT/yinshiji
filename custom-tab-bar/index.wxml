<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view
    class="tab-item"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon icon-{{item.key}} {{selected === index ? 'icon-active' : ''}}"></view>
    <view class="tab-label {{selected === index ? 'label-active' : ''}}">{{item.text}}</view>
  </view>
</view>
