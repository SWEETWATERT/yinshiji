/* ── Custom Tab Bar ── */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 999;
}

.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: #E9E1D8;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding-top: 10rpx;
}

.tab-label {
  color: #8D8499;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.label-active {
  color: #8B6CFF;
  font-weight: 700;
}

/* ── Tab Icons via SVG data URI ── */
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* Home */
